    "Conservative ads and tracking list focused on zero breakage.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurückhaltende Werbe- und Tracking-Liste, die nichts kaputt machen soll."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista prudente de anuncios y rastreo pensada para no estropear nada."
          }
        },
