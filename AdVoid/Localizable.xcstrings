    "Apps that use their own encrypted DNS, and Safari with iCloud Private Relay on. iOS runs one VPN at a time, so another VPN turns AdVoid off." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps mit eigenem verschlüsseltem DNS sowie Safari mit aktiviertem iCloud Privat-Relay. iOS führt immer nur ein VPN aus, ein anderes VPN schaltet AdVoid also aus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les apps qui utilisent leur propre DNS chiffré, et Safari avec le relais privé iCloud activé. iOS n’exécute qu’un VPN à la fois : un autre VPN désactive AdVoid."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las apps que usan su propio DNS cifrado, y Safari con Relay privado de iCloud activado. iOS ejecuta una sola VPN a la vez, así que otra VPN desactiva AdVoid."
          }
        }
      }
    },
