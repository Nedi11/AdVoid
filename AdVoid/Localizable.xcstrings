    "Tap to block ads and trackers across your iPhone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe, um Werbung und Tracker auf deinem ganzen iPhone zu blockieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para bloquear anuncios y rastreadores en todo tu iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez pour bloquer les publicités et traqueurs sur tout votre iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca per bloccare pubblicità e tracciamento su tutto il tuo iPhone."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to block ads and trackers across your iPhone."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to block ads and trackers across your iPhone."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to block ads and trackers across your iPhone."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para bloquear anuncios y rastreadores en todo tu iPhone."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez pour bloquer les publicités et traqueurs sur tout votre iPhone."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر لمنع الإعلانات وأجهزة التتبع عبر iPhone."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toqueu per bloquejar anuncis i rastrejadors al vostre iPhone."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε για να αποκλείσετε διαφημίσεις και ιχνηλάτες στο iPhone."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার iPhone জুড়ে বিজ্ঞাপন এবং ট্র্যাকারগুলি ব্লক করতে আলতো চাপুন৷"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím zablokujete reklamy a sledovače ve svém iPhone."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta estääksesi mainokset ja seurantalaitteet iPhone-laitteessasi."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા સમગ્ર iPhone પર જાહેરાતો અને ટ્રેકર્સને અવરોધિત કરવા માટે ટૅપ કરો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने iPhone पर विज्ञापनों और ट्रैकर्स को ब्लॉक करने के लिए टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirnite za blokiranje oglasa i programa za praćenje na vašem iPhone."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk for at blokere annoncer og trackere på tværs af din iPhone."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk untuk memblokir iklan dan pelacak di iPhone Anda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップして、iPhone 全体の広告とトラッカーをブロックします。"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppintson a hirdetések és nyomkövetők letiltásához a iPhone készüléken."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone에서 광고와 추적기를 차단하려면 탭하세요."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ iPhone ನಾದ್ಯಂತ ಜಾಹೀರಾತುಗಳು ಮತ್ತು ಟ್ರ್ಯಾಕರ್‌ಗಳನ್ನು ನಿರ್ಬಂಧಿಸಲು ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या iPhone वर जाहिराती आणि ट्रॅकर्स ब्लॉक करण्यासाठी टॅप करा."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ iPhone-ൽ ഉടനീളം പരസ്യങ്ങളും ട്രാക്കറുകളും തടയാൻ ടാപ്പ് ചെയ്യുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik untuk menyekat iklan dan penjejak merentas iPhone anda."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik om advertenties en trackers op uw iPhone te blokkeren."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କର iPhone ମଧ୍ୟରେ ବିଜ୍ଞାପନ ଏବଂ ଟ୍ରାକରଗୁଡିକୁ ଅବରୋଧ କରିବାକୁ ଟ୍ୟାପ୍ କରନ୍ତୁ |"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਪਣੇ iPhone ਵਿੱਚ ਵਿਗਿਆਪਨਾਂ ਅਤੇ ਟਰੈਕਰਾਂ ਨੂੰ ਬਲੌਕ ਕਰਨ ਲਈ ਟੈਪ ਕਰੋ।"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk for å blokkere annonser og sporere på hele iPhone."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij, aby zablokować reklamy i moduły śledzące w urządzeniu iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para bloquear anúncios e rastreadores em seu iPhone."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para bloquear anúncios e rastreadores em seu iPhone."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atingeți pentru a bloca reclamele și instrumentele de urmărire pe iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите, чтобы заблокировать рекламу и трекеры на вашем iPhone."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotaknite se, da blokirate oglase in sledilnike v vašem iPhone."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím zablokujete reklamy a sledovače vo svojom iPhone."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck för att blockera annonser och spårare på din iPhone."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் iPhone முழுவதும் விளம்பரங்கள் மற்றும் டிராக்கர்களைத் தடுக்க தட்டவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะเพื่อบล็อกโฆษณาและเครื่องมือติดตามทั่ว iPhone ของคุณ"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ iPhone అంతటా ప్రకటనలు మరియు ట్రాకర్‌లను బ్లాక్ చేయడానికి నొక్కండి."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться, щоб заблокувати рекламу та трекери на вашому iPhone."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنے iPhone پر اشتہارات اور ٹریکرز کو مسدود کرنے کے لیے تھپتھپائیں۔"
          }
        },
        "zh-Hans": {
