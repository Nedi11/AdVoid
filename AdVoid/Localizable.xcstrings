    "Lists check for updates when you open AdVoid, at most every 12 hours. iOS doesn't let them update while the app is closed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listen suchen beim Öffnen von AdVoid nach Updates, höchstens alle 12 Stunden. iOS erlaubt keine Updates, während die App geschlossen ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las listas buscan actualizaciones al abrir AdVoid, como mucho cada 12 horas. iOS no permite actualizarlas con la app cerrada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les listes recherchent des mises à jour à l’ouverture d’AdVoid, au plus toutes les 12 heures. iOS ne permet pas de les mettre à jour quand l’app est fermée."
          }
        }
      }
    },
