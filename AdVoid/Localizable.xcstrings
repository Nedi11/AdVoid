    "System follows the language set for AdVoid in the iOS Settings app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„System“ folgt der Sprache, die in der iOS-App „Einstellungen“ für AdVoid festgelegt ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Sistema» sigue el idioma elegido para AdVoid en la app Ajustes de iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Système » suit la langue choisie pour AdVoid dans l’app Réglages d’iOS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistema segue la lingua impostata per AdVoid nell'app Impostazioni di iOS."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "System follows the language set for AdVoid in the iOS Settings app."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "System follows the language set for AdVoid in the iOS Settings app."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "System follows the language set for AdVoid in the iOS Settings app."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "«Sistema» sigue el idioma elegido para AdVoid en la app Ajustes de iOS."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "« Système » suit la langue choisie pour AdVoid dans l’app Réglages d’iOS."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتبع النظام اللغة التي تم تعيينها لـ AdVoid في تطبيق إعدادات iOS."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El sistema segueix l'idioma establert per a AdVoid a l'aplicació Configuració iOS."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το σύστημα ακολουθεί τη γλώσσα που έχει οριστεί για το AdVoid στην εφαρμογή Ρυθμίσεις iOS."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সিস্টেম iOS সেটিংস অ্যাপে AdVoid-এর জন্য সেট করা ভাষা অনুসরণ করে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Systém se řídí jazykem nastaveným pro AdVoid v aplikaci Nastavení iOS."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Järjestelmä noudattaa iOS-asetukset-sovelluksessa AdVoid:lle asetettua kieltä."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સિસ્ટમ iOS સેટિંગ્સ એપ્લિકેશનમાં AdVoid માટે સેટ કરેલી ભાષાને અનુસરે છે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम iOS सेटिंग्स ऐप में AdVoid के लिए निर्धारित भाषा का अनुसरण करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sustav slijedi jezik postavljen za AdVoid u aplikaciji Postavke iOS."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemet følger det sprog, der er indstillet til AdVoid i appen iOS Indstillinger."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem mengikuti bahasa yang ditetapkan untuk AdVoid di aplikasi Pengaturan iOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムは、iOS 設定アプリで AdVoid に設定された言語に従います。"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A rendszer a iOS Beállítások alkalmazásban AdVoid számára beállított nyelvet követi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템은 iOS 설정 앱에서 AdVoid에 대해 설정된 언어를 따릅니다."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ಸೆಟ್ಟಿಂಗ್‌ಗಳ ಅಪ್ಲಿಕೇಶನ್‌ನಲ್ಲಿ AdVoid ಗಾಗಿ ಹೊಂದಿಸಲಾದ ಭಾಷೆಯನ್ನು ಸಿಸ್ಟಮ್ ಅನುಸರಿಸುತ್ತದೆ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रणाली iOS सेटिंग्ज ॲपमध्ये AdVoid साठी सेट केलेली भाषा फॉलो करते."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ക്രമീകരണ ആപ്പിൽ AdVoid എന്നതിനായി സജ്ജമാക്കിയിരിക്കുന്ന ഭാഷയാണ് സിസ്റ്റം പിന്തുടരുന്നത്."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem mengikut bahasa yang ditetapkan untuk AdVoid dalam apl Tetapan iOS."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Het systeem volgt de taal die is ingesteld voor AdVoid in de app iOS Instellingen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସିଷ୍ଟମ୍ iOS ସେଟିଂସମୂହ ଆପରେ AdVoid ପାଇଁ ଭାଷା ସେଟ୍ ଅନୁସରଣ କରେ |"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਿਸਟਮ iOS ਸੈਟਿੰਗਾਂ ਐਪ ਵਿੱਚ AdVoid ਲਈ ਸੈੱਟ ਕੀਤੀ ਭਾਸ਼ਾ ਦਾ ਅਨੁਸਰਣ ਕਰਦਾ ਹੈ।"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemet følger språket som er satt for AdVoid i iOS Innstillinger-appen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "System obsługuje język ustawiony dla AdVoid w aplikacji Ustawienia iOS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O sistema segue o idioma definido para AdVoid no aplicativo Configurações iOS."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O sistema segue o idioma definido para AdVoid no aplicativo Configurações iOS."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistemul urmează limba setată pentru AdVoid în aplicația Setări iOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Система соответствует языку, установленному для AdVoid в приложении «Настройки iOS»."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem sledi jeziku, nastavljenemu za AdVoid v aplikaciji Nastavitve iOS."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Systém sa riadi jazykom nastaveným pre AdVoid v aplikácii Nastavenia iOS."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemet följer språket som ställts in för AdVoid i appen iOS Inställningar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS அமைப்புகள் பயன்பாட்டில் AdVoid க்கு அமைக்கப்பட்ட மொழியை கணினி பின்பற்றுகிறது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระบบจะเป็นไปตามภาษาที่ตั้งไว้สำหรับ AdVoid ในแอปการตั้งค่า iOS"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సిస్టమ్ iOS సెట్టింగ్‌ల యాప్‌లో AdVoid కోసం సెట్ చేయబడిన భాషని అనుసరిస్తుంది."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Система використовує мову, встановлену для AdVoid у програмі налаштувань iOS."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سسٹم iOS ترتیبات ایپ میں AdVoid کے لیے سیٹ کردہ زبان کی پیروی کرتا ہے۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统遵循 iOS 设置应用程序中为 AdVoid 设置的语言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統遵循 iOS 設定應用程式中為 AdVoid 設定的語言。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hệ thống tuân theo ngôn ngữ được đặt cho AdVoid trong ứng dụng Cài đặt iOS."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem, iOS Ayarları uygulamasında AdVoid için ayarlanan dili takip eder."
          }
        }
      }
    },
