        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Cloudflare Family αποκλείει επίσης κακόβουλο λογισμικό και ιστότοπους για ενηλίκους."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Family ম্যালওয়্যার এবং প্রাপ্তবয়স্কদের সাইটগুলিকেও ব্লক করে৷"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Family také blokuje malware a stránky pro dospělé."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Family estää myös haittaohjelmat ja aikuisille suunnatut sivustot."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Family માલવેર અને એડલ્ટ સાઇટ્સને પણ બ્લોક કરે છે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Family मैलवेयर और वयस्क साइटों को भी ब्लॉक करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Family također blokira zlonamjerni softver i stranice za odrasle."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Family blokerer også malware og voksenwebsteder."
          }
