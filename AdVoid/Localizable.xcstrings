    "Add any list by link. It updates along with the built-in lists.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge beliebige Listen per Link hinzu. Sie werden zusammen mit den integrierten Listen aktualisiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade cualquier lista mediante un enlace. Se actualiza junto con las listas integradas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez n’importe quelle liste par lien. Elle se met à jour avec les listes intégrées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi qualsiasi lista tramite link. Si aggiorna insieme alle liste integrate."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Add any list by link. It updates along with the built-in lists."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Add any list by link. It updates along with the built-in lists."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Add any list by link. It updates along with the built-in lists."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade cualquier lista mediante un enlace. Se actualiza junto con las listas integradas."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez n’importe quelle liste par lien. Elle se met à jour avec les listes intégrées."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إضافة أي قائمة عن طريق الرابط. يتم تحديثه مع القوائم المضمنة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Afegeix qualsevol llista per enllaç. S'actualitza juntament amb les llistes integrades."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε οποιαδήποτε λίστα με σύνδεσμο. Ενημερώνεται μαζί με τις ενσωματωμένες λίστες."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লিঙ্ক দ্বারা কোনো তালিকা যোগ করুন. এটি অন্তর্নির্মিত তালিকার সাথে আপডেট হয়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte libovolný seznam pomocí odkazu. Aktualizuje se spolu s vestavěnými seznamy."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää mikä tahansa luettelo linkin kautta. Se päivittyy sisäänrakennettujen luetteloiden mukana."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "લિંક દ્વારા કોઈપણ સૂચિ ઉમેરો. તે બિલ્ટ-ઇન સૂચિઓ સાથે અપડેટ થાય છે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी भी सूची को लिंक द्वारा जोड़ें. यह अंतर्निहित सूचियों के साथ अद्यतन होता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodajte bilo koji popis putem veze. Ažurira se zajedno s ugrađenim popisima."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj enhver liste via link. Den opdateres sammen med de indbyggede lister."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan daftar apa pun melalui tautan. Itu diperbarui bersama dengan daftar bawaan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクを使用してリストを追加します。組み込みリストとともに更新されます。"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjon hozzá tetszőleges listát hivatkozással. A beépített listákkal együtt frissül."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크로 목록을 추가하세요. 내장 목록과 함께 업데이트됩니다."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಲಿಂಕ್ ಮೂಲಕ ಯಾವುದೇ ಪಟ್ಟಿಯನ್ನು ಸೇರಿಸಿ. ಇದು ಅಂತರ್ನಿರ್ಮಿತ ಪಟ್ಟಿಗಳೊಂದಿಗೆ ನವೀಕರಿಸುತ್ತದೆ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "लिंकद्वारे कोणतीही यादी जोडा. हे अंगभूत सूचीसह अद्यतनित होते."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ലിങ്ക് വഴി ഏതെങ്കിലും ലിസ്റ്റ് ചേർക്കുക. ബിൽറ്റ്-ഇൻ ലിസ്റ്റുകൾക്കൊപ്പം ഇത് അപ്ഡേറ്റ് ചെയ്യുന്നു."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan sebarang senarai melalui pautan. Ia dikemas kini bersama-sama dengan senarai terbina dalam."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een lijst toe via een link. Het wordt samen met de ingebouwde lijsten bijgewerkt."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଲିଙ୍କ୍ ଦ୍ୱାରା ଯେକ list ଣସି ତାଲିକା ଯୋଡନ୍ତୁ | ଏହା ବିଲ୍ଟ-ଇନ୍ ତାଲିକା ସହିତ ଅପଡେଟ୍ କରେ |"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਲਿੰਕ ਦੁਆਰਾ ਕੋਈ ਵੀ ਸੂਚੀ ਸ਼ਾਮਲ ਕਰੋ। ਇਹ ਬਿਲਟ-ਇਨ ਸੂਚੀਆਂ ਦੇ ਨਾਲ ਅਪਡੇਟ ਹੁੰਦਾ ਹੈ।"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til en liste via lenke. Den oppdateres sammen med de innebygde listene."
          }
        },
        "pl": {
