    "Your other traffic isn't routed through AdVoid, and your activity history never leaves this device. Allowed lookups go to the DNS provider you choose, encrypted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein übriger Datenverkehr läuft nicht über AdVoid, und dein Aktivitätsverlauf verlässt nie dieses Gerät. Erlaubte Anfragen gehen verschlüsselt an den DNS-Anbieter deiner Wahl."
          }
        },
