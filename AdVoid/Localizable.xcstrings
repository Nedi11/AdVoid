        }
      }
    },
    "Your other traffic isn't routed through AdVoid, and your activity history never leaves this device. Allowed lookups go to the DNS provider you choose, encrypted.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein übriger Datenverkehr läuft nicht über AdVoid, und dein Aktivitätsverlauf verlässt nie dieses Gerät. Erlaubte Anfragen gehen verschlüsselt an den DNS-Anbieter deiner Wahl."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resto de tu tráfico no pasa por AdVoid y tu historial de actividad nunca sale de este dispositivo. Las consultas permitidas van cifradas al proveedor de DNS que elijas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le reste de votre trafic ne passe pas par AdVoid, et votre historique d’activité ne quitte jamais cet appareil. Les requêtes autorisées vont, chiffrées, au fournisseur DNS de votre choix."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il resto del traffico non passa attraverso AdVoid e la cronologia delle attività non lascia mai questo dispositivo. Le richieste DNS consentite vengono inviate crittografate al provider DNS che scegli."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Your other traffic isn't routed through AdVoid, and your activity history never leaves this device. Allowed lookups go to the DNS provider you choose, encrypted."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Your other traffic isn't routed through AdVoid, and your activity history never leaves this device. Allowed lookups go to the DNS provider you choose, encrypted."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your other traffic isn't routed through AdVoid, and your activity history never leaves this device. Allowed lookups go to the DNS provider you choose, encrypted."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El resto de tu tráfico no pasa por AdVoid y tu historial de actividad nunca sale de este dispositivo. Las consultas permitidas van cifradas al proveedor de DNS que elijas."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le reste de votre trafic ne passe pas par AdVoid, et votre historique d’activité ne quitte jamais cet appareil. Les requêtes autorisées vont, chiffrées, au fournisseur DNS de votre choix."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتم توجيه حركة المرور الأخرى الخاصة بك عبر AdVoid، ولن يغادر سجل نشاطك هذا الجهاز أبدًا. تذهب عمليات البحث المسموح بها إلى موفر DNS الذي تختاره، بشكل مشفر."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'altre trànsit no s'encamina a través de AdVoid i el vostre historial d'activitats no surt mai d'aquest dispositiu. Les cerques permeses van al proveïdor DNS que trieu, xifrades."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η άλλη επισκεψιμότητά σας δεν δρομολογείται μέσω του AdVoid και το ιστορικό δραστηριότητάς σας δεν φεύγει ποτέ από αυτήν τη συσκευή. Οι επιτρεπόμενες αναζητήσεις πηγαίνουν στον πάροχο DNS που επιλέγετε, κρυπτογραφημένες."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার অন্যান্য ট্র্যাফিক AdVoid এর মাধ্যমে রুট করা হয় না এবং আপনার কার্যকলাপের ইতিহাস কখনই এই ডিভাইসটি ছেড়ে যায় না। এনক্রিপ্ট করা আপনার বেছে নেওয়া DNS প্রদানকারীর কাছে অনুমোদিত লুকআপগুলি যায়৷"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš další provoz není směrován přes AdVoid a vaše historie aktivit nikdy neopustí toto zařízení. Povolená vyhledávání jdou k poskytovateli DNS, kterého si vyberete, zašifrovaná."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muuta liikennettäsi ei reititetä AdVoid:n kautta, eikä toimintahistoriasi koskaan poistu tältä laitteelta. Sallitut haut menevät valitsemallesi DNS-palveluntarjoajalle salattuna."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા અન્ય ટ્રાફિકને AdVoid દ્વારા રૂટ કરવામાં આવતો નથી અને તમારો પ્રવૃત્તિ ઇતિહાસ ક્યારેય આ ઉપકરણને છોડતો નથી. મંજૂર લુકઅપ્સ તમે પસંદ કરો છો તે DNS પ્રદાતા પર જાય છે, એન્ક્રિપ્ટેડ."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका अन्य ट्रैफ़िक AdVoid के माध्यम से रूट नहीं किया जाता है, और आपका गतिविधि इतिहास इस डिवाइस को कभी नहीं छोड़ता है। अनुमत लुकअप एन्क्रिप्टेड रूप में आपके द्वारा चुने गए DNS प्रदाता के पास जाते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš drugi promet ne usmjerava se kroz AdVoid, a vaša povijest aktivnosti nikada ne napušta ovaj uređaj. Dopuštena pretraživanja idu kod DNS pružatelja usluga kojeg odaberete, šifrirano."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din øvrige trafik dirigeres ikke gennem AdVoid, og din aktivitetshistorik forlader aldrig denne enhed. Tilladte opslag går til den DNS-udbyder, du vælger, krypteret."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lalu lintas Anda yang lain tidak dirutekan melalui AdVoid, dan riwayat aktivitas Anda tidak pernah keluar dari perangkat ini. Pencarian yang diizinkan masuk ke penyedia DNS yang Anda pilih, dienkripsi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のトラフィックは AdVoid 経由でルーティングされず、アクティビティ履歴がこのデバイスの外に残ることはありません。許可された検索は、暗号化されて、選択した DNS プロバイダーに送信されます。"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A többi forgalom nem a AdVoid-n keresztül történik, és tevékenységi előzményei soha nem hagyják el ezt az eszközt. Az engedélyezett keresések az Ön által választott DNS szolgáltatóhoz mennek, titkosítva."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 트래픽은 AdVoid를 통해 라우팅되지 않으며 활동 기록이 이 기기를 떠나지 않습니다. 허용된 조회는 귀하가 선택한 DNS 제공업체로 암호화되어 이동됩니다."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಇತರ ಟ್ರಾಫಿಕ್ ಅನ್ನು AdVoid ಮೂಲಕ ರೂಟ್ ಮಾಡಲಾಗಿಲ್ಲ ಮತ್ತು ನಿಮ್ಮ ಚಟುವಟಿಕೆಯ ಇತಿಹಾಸವು ಈ ಸಾಧನವನ್ನು ಬಿಟ್ಟು ಹೋಗುವುದಿಲ್ಲ. ಅನುಮತಿಸಲಾದ ಲುಕ್‌ಅಪ್‌ಗಳು ನೀವು ಆಯ್ಕೆಮಾಡಿದ, ಎನ್‌ಕ್ರಿಪ್ಟ್ ಮಾಡಿದ DNS ಪೂರೈಕೆದಾರರಿಗೆ ಹೋಗುತ್ತವೆ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचा इतर ट्रॅफिक AdVoid द्वारे राउट केला जात नाही आणि तुमचा ॲक्टिव्हिटी इतिहास हे डिव्हाइस कधीही सोडत नाही. अनुमत लुकअप तुम्ही निवडलेल्या DNS प्रदात्याकडे जातात, एनक्रिप्ट केलेले."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ മറ്റ് ട്രാഫിക് AdVoid വഴി റൂട്ട് ചെയ്യപ്പെടുന്നില്ല, നിങ്ങളുടെ പ്രവർത്തന ചരിത്രം ഒരിക്കലും ഈ ഉപകരണത്തിൽ നിന്ന് പുറത്തുപോകില്ല. അനുവദനീയമായ ലുക്കപ്പുകൾ നിങ്ങൾ തിരഞ്ഞെടുക്കുന്ന, എൻക്രിപ്റ്റ് ചെയ്ത DNS ദാതാവിലേക്ക് പോകുന്നു."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Trafik anda yang lain tidak dihalakan melalui AdVoid dan sejarah aktiviti anda tidak pernah meninggalkan peranti ini. Carian yang dibenarkan pergi ke pembekal DNS yang anda pilih, disulitkan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw overige verkeer wordt niet via de AdVoid geleid en uw activiteitengeschiedenis verlaat dit apparaat nooit. Toegestane zoekopdrachten gaan gecodeerd naar de DNS-provider die u kiest."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କର ଅନ୍ୟ ଟ୍ରାଫିକ୍ AdVoid ମାଧ୍ୟମରେ ମାର୍ଗଦର୍ଶନ କରାଯାଇ ନାହିଁ, ଏବଂ ଆପଣଙ୍କର କାର୍ଯ୍ୟକଳାପ ଇତିହାସ ଏହି ଉପକରଣକୁ କେବେବି ଛାଡିବ ନାହିଁ | ଅନୁମୋଦିତ ସନ୍ଧାନଗୁଡିକ ଆପଣ ବାଛିଥିବା, ଏନକ୍ରିପ୍ଟ ହୋଇଥିବା DNS ପ୍ରଦାନକାରୀଙ୍କୁ ଯାଆନ୍ତୁ |"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡਾ ਹੋਰ ਟ੍ਰੈਫਿਕ AdVoid ਦੁਆਰਾ ਰੂਟ ਨਹੀਂ ਕੀਤਾ ਜਾਂਦਾ ਹੈ, ਅਤੇ ਤੁਹਾਡਾ ਗਤੀਵਿਧੀ ਇਤਿਹਾਸ ਕਦੇ ਵੀ ਇਸ ਡਿਵਾਈਸ ਨੂੰ ਨਹੀਂ ਛੱਡਦਾ ਹੈ। ਮਨਜ਼ੂਰਸ਼ੁਦਾ ਲੁੱਕਅੱਪ ਤੁਹਾਡੇ ਦੁਆਰਾ ਚੁਣੇ ਗਏ DNS ਪ੍ਰਦਾਤਾ ਨੂੰ ਜਾਂਦੇ ਹਨ, ਐਨਕ੍ਰਿਪਟਡ।"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den andre trafikken din rutes ikke gjennom AdVoid, og aktivitetsloggen din forlater aldri denne enheten. Tillatte oppslag går til DNS-leverandøren du velger, kryptert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostały ruch nie jest kierowany przez AdVoid, a historia Twojej aktywności nigdy nie opuszcza tego urządzenia. Dozwolone wyszukiwania trafiają do wybranego dostawcy DNS w postaci zaszyfrowanej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu outro tráfego não é roteado por AdVoid e seu histórico de atividades nunca sai deste dispositivo. As pesquisas permitidas vão para o provedor DNS que você escolher, criptografadas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu outro tráfego não é roteado por AdVoid e seu histórico de atividades nunca sai deste dispositivo. As pesquisas permitidas vão para o provedor DNS que você escolher, criptografadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Celălalt trafic al dvs. nu este direcționat prin AdVoid, iar istoricul activității dvs. nu părăsește niciodată acest dispozitiv. Căutările permise ajung la furnizorul DNS pe care îl alegeți, criptate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другой ваш трафик не маршрутизируется через AdVoid, и история вашей активности никогда не покидает это устройство. Разрешенные запросы передаются выбранному вами провайдеру DNS в зашифрованном виде."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš drugi promet ni usmerjen prek AdVoid in vaša zgodovina dejavnosti nikoli ne zapusti te naprave. Dovoljena iskanja gredo šifrirano ponudniku DNS, ki ga izberete."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša ostatná prevádzka nie je smerovaná cez AdVoid a vaša história aktivít nikdy neopustí toto zariadenie. Povolené vyhľadávania smerujú k poskytovateľovi DNS, ktorého si vyberiete, zašifrované."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din övriga trafik dirigeras inte genom AdVoid, och din aktivitetshistorik lämnar aldrig den här enheten. Tillåtna uppslagningar går till den DNS-leverantör du väljer, krypterad."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் மற்ற போக்குவரத்து AdVoid வழியாக அனுப்பப்படவில்லை, மேலும் உங்கள் செயல்பாட்டு வரலாறு இந்தச் சாதனத்தை விட்டு வெளியேறாது. அனுமதிக்கப்பட்ட தேடல்கள் நீங்கள் தேர்வுசெய்து, மறைகுறியாக்கப்பட்ட DNS வழங்குநருக்குச் செல்லும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การรับส่งข้อมูลอื่นๆ ของคุณไม่ได้ถูกกำหนดเส้นทางผ่าน AdVoid และประวัติกิจกรรมของคุณจะไม่ออกจากอุปกรณ์นี้ การค้นหาที่อนุญาตไปที่ผู้ให้บริการ DNS ที่คุณเลือก โดยมีการเข้ารหัส"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ఇతర ట్రాఫిక్ AdVoid ద్వారా మళ్లించబడదు మరియు మీ కార్యాచరణ చరిత్ర ఈ పరికరాన్ని ఎప్పటికీ వదిలివేయదు. అనుమతించబడిన శోధనలు మీరు ఎంచుకున్న, ఎన్‌క్రిప్ట్ చేయబడిన DNS ప్రొవైడర్‌కి వెళ్తాయి."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш інший трафік не направляється через AdVoid, і ваша історія активності ніколи не залишає цей пристрій. Дозволені пошуки надходять до обраного вами постачальника DNS у зашифрованому вигляді."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی دوسری ٹریفک AdVoid کے ذریعے نہیں جاتی ہے، اور آپ کی سرگرمی کی سرگزشت کبھی بھی اس آلے کو نہیں چھوڑتی ہے۔ اجازت شدہ تلاش آپ کے منتخب کردہ DNS فراہم کنندہ کے پاس جاتی ہیں، خفیہ کردہ۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的其他流量不会通过 AdVoid 路由，并且您的活动历史记录永远不会离开此设备。允许的查找将转至您选择的 DNS 提供商（已加密）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的其他流量不會透過 AdVoid 路由，並且您的活動記錄永遠不會離開此裝置。允許的查找將轉至您選擇的 DNS 提供者（已加密）。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu lượng truy cập khác của bạn không được định tuyến qua AdVoid và lịch sử hoạt động của bạn sẽ không bao giờ rời khỏi thiết bị này. Tra cứu được phép chuyển đến nhà cung cấp DNS mà bạn chọn, được mã hóa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer trafiğiniz AdVoid üzerinden yönlendirilmez ve etkinlik geçmişiniz bu cihazdan asla ayrılmaz. İzin verilen aramalar seçtiğiniz DNS sağlayıcısına şifrelenmiş olarak gider."
          }
        }
      }
    },
    "YouTube and a few other apps send ads from the same servers as their videos. Blocking them would break the app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube und einige andere Apps liefern Werbung über dieselben Server aus wie ihre Videos. Sie zu blockieren würde die App lahmlegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube y algunas otras apps envían anuncios desde los mismos servidores que sus vídeos. Bloquearlos estropearía la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube et quelques autres apps diffusent leurs pubs depuis les mêmes serveurs que leurs vidéos. Les bloquer casserait l’app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube e alcune altre app inviano le pubblicità dagli stessi server dei video. Bloccarli impedirebbe all'app di funzionare."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube and a few other apps send ads from the same servers as their videos. Blocking them would break the app."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube and a few other apps send ads from the same servers as their videos. Blocking them would break the app."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube and a few other apps send ads from the same servers as their videos. Blocking them would break the app."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube y algunas otras apps envían anuncios desde los mismos servidores que sus vídeos. Bloquearlos estropearía la app."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube et quelques autres apps diffusent leurs pubs depuis les mêmes serveurs que leurs vidéos. Les bloquer casserait l’app."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسل YouTube وعدد قليل من التطبيقات الأخرى إعلانات من نفس الخوادم مثل مقاطع الفيديو الخاصة بهم. سيؤدي حظرهم إلى كسر التطبيق."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube i algunes altres aplicacions envien anuncis des dels mateixos servidors que els seus vídeos. Bloquejar-los trencaria l'aplicació."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το YouTube και μερικές άλλες εφαρμογές στέλνουν διαφημίσεις από τους ίδιους διακομιστές με τα βίντεό τους. Ο αποκλεισμός τους θα έσπασε την εφαρμογή."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube এবং কয়েকটি অন্যান্য অ্যাপ তাদের ভিডিওর মতো একই সার্ভার থেকে বিজ্ঞাপন পাঠায়। তাদের ব্লক করলে অ্যাপটি ভেঙে যাবে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube a několik dalších aplikací odesílají reklamy ze stejných serverů jako jejich videa. Jejich zablokování by aplikaci přerušilo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube ja muutamat muut sovellukset lähettävät mainoksia samoista palvelimista kuin heidän videonsa. Niiden estäminen rikkoisi sovelluksen."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube અને કેટલીક અન્ય એપ્લિકેશનો તેમના વીડિયોની જેમ જ સર્વર પરથી જાહેરાતો મોકલે છે. તેમને બ્લોક કરવાથી એપ તૂટી જશે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube और कुछ अन्य ऐप्स उन्हीं सर्वर से विज्ञापन भेजते हैं जिनसे उनके वीडियो चलते हैं। उन्हें ब्लॉक करने से ऐप टूट जाएगा."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube i nekoliko drugih aplikacija šalju oglase s istih poslužitelja kao i njihovi videozapisi. Njihovo blokiranje pokvarilo bi aplikaciju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube og et par andre apps sender annoncer fra de samme servere som deres videoer. Blokering af dem ville ødelægge appen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube dan beberapa aplikasi lain mengirimkan iklan dari server yang sama dengan videonya. Memblokirnya akan merusak aplikasi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube や他のいくつかのアプリは、動画と同じサーバーから広告を送信します。それらをブロックするとアプリが破損します。"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A YouTube és néhány más alkalmazás ugyanazokról a szerverekről küld hirdetéseket, mint a videóik. Letiltásuk megszakítaná az alkalmazást."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube 및 기타 몇 가지 앱은 동영상과 동일한 서버에서 광고를 보냅니다. 차단하면 앱이 중단됩니다."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube ಮತ್ತು ಕೆಲವು ಇತರ ಅಪ್ಲಿಕೇಶನ್‌ಗಳು ತಮ್ಮ ವೀಡಿಯೊಗಳಂತೆಯೇ ಅದೇ ಸರ್ವರ್‌ಗಳಿಂದ ಜಾಹೀರಾತುಗಳನ್ನು ಕಳುಹಿಸುತ್ತವೆ. ಅವುಗಳನ್ನು ನಿರ್ಬಂಧಿಸುವುದು ಅಪ್ಲಿಕೇಶನ್ ಅನ್ನು ಮುರಿಯುತ್ತದೆ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube आणि काही इतर ॲप्स त्यांच्या व्हिडिओंप्रमाणेच सर्व्हरवरून जाहिराती पाठवतात. त्यांना ब्लॉक केल्यास ॲप खंडित होईल."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube ഉം മറ്റ് ചില ആപ്പുകളും അവരുടെ വീഡിയോകൾ പോലെയുള്ള അതേ സെർവറുകളിൽ നിന്ന് പരസ്യങ്ങൾ അയയ്ക്കുന്നു. അവരെ തടയുന്നത് ആപ്പിനെ തകർക്കും."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube dan beberapa apl lain menghantar iklan dari pelayan yang sama seperti video mereka. Menyekat mereka akan memecahkan apl."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube en een paar andere apps sturen advertenties vanaf dezelfde servers als hun video's. Als je ze blokkeert, zou de app kapot gaan."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube ଏବଂ ଅନ୍ୟ କେତେକ ଆପ୍ ସମାନ ସର୍ଭରରୁ ବିଜ୍ଞାପନ ପଠାନ୍ତି | ସେମାନଙ୍କୁ ଅବରୋଧ କରିବା ଦ୍ୱାରା ଆପ୍ ଭାଙ୍ଗିଯିବ |"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube ਅਤੇ ਕੁਝ ਹੋਰ ਐਪਾਂ ਉਹਨਾਂ ਦੇ ਵੀਡੀਓ ਦੇ ਰੂਪ ਵਿੱਚ ਉਹਨਾਂ ਸਰਵਰਾਂ ਤੋਂ ਵਿਗਿਆਪਨ ਭੇਜਦੀਆਂ ਹਨ। ਉਹਨਾਂ ਨੂੰ ਬਲੌਕ ਕਰਨਾ ਐਪ ਨੂੰ ਤੋੜ ਦੇਵੇਗਾ।"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube og noen få andre apper sender annonser fra de samme serverne som videoene deres. Å blokkere dem ville ødelegge appen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube i kilka innych aplikacji wysyła reklamy z tych samych serwerów, co ich filmy. Zablokowanie ich spowodowałoby uszkodzenie aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube e alguns outros aplicativos enviam anúncios dos mesmos servidores que seus vídeos. Bloqueá-los quebraria o aplicativo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube e alguns outros aplicativos enviam anúncios dos mesmos servidores que seus vídeos. Bloqueá-los quebraria o aplicativo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube și alte câteva aplicații trimit reclame de pe aceleași servere ca și videoclipurile lor. Blocarea lor ar rupe aplicația."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube и несколько других приложений отправляют рекламу с тех же серверов, что и их видео. Их блокировка приведет к поломке приложения."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube in nekaj drugih aplikacij pošiljajo oglase iz istih strežnikov kot njihovi videoposnetki. Če bi jih blokirali, bi pokvaril aplikacijo."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube a niekoľko ďalších aplikácií odosielajú reklamy z rovnakých serverov ako ich videá. Ich zablokovanie by prerušilo aplikáciu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube och några andra appar skickar annonser från samma servrar som deras videor. Att blockera dem skulle förstöra appen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube மற்றும் வேறு சில பயன்பாடுகள் அவற்றின் வீடியோக்கள் இருக்கும் அதே சேவையகங்களிலிருந்து விளம்பரங்களை அனுப்புகின்றன. அவற்றைத் தடுப்பது பயன்பாட்டை உடைத்துவிடும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube และแอปอื่นๆ สองสามแอปส่งโฆษณาจากเซิร์ฟเวอร์เดียวกันกับวิดีโอของพวกเขา การบล็อกจะทำให้แอปเสียหาย"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube మరియు కొన్ని ఇతర యాప్‌లు తమ వీడియోల వలె అదే సర్వర్‌ల నుండి ప్రకటనలను పంపుతాయి. వాటిని బ్లాక్ చేయడం యాప్ విచ్ఛిన్నమవుతుంది."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube і кілька інших програм надсилають рекламу з тих самих серверів, що й їхні відео. Якщо їх заблокувати, додаток буде зламано."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube اور کچھ دیگر ایپس انہی سرورز سے اشتہارات بھیجتی ہیں جو ان کی ویڈیوز ہیں۔ انہیں بلاک کرنے سے ایپ ٹوٹ جائے گی۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube 和其他一些应用程序从与其视频相同的服务器发送广告。阻止它们会破坏应用程序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube 和其他一些應用程式從與其影片相同的伺服器發送廣告。阻止它們會破壞應用程式。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube và một số ứng dụng khác gửi quảng cáo từ cùng máy chủ với video của họ. Chặn chúng sẽ làm hỏng ứng dụng."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube ve diğer birkaç uygulama, videolarıyla aynı sunuculardan reklam gönderir. Bunları engellemek uygulamayı bozar."
          }
        }
      }
    },
    "YouTube and some other apps serve ads from the same servers as their content. Blocking those servers would break the app too.": {
