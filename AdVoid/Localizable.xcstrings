    "Turn on protection to see what your apps connect to.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere den Schutz, um zu sehen, womit sich deine Apps verbinden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa la protección para ver a qué se conectan tus apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez la protection pour voir à quoi se connectent vos apps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva la protezione per vedere a cosa si connettono le tue app."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on protection to see what your apps connect to."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on protection to see what your apps connect to."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on protection to see what your apps connect to."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa la protección para ver a qué se conectan tus apps."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez la protection pour voir à quoi se connectent vos apps."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتشغيل الحماية لمعرفة ما تتصل به تطبيقاتك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa la protecció per veure a què es connecten les teves aplicacions."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργοποιήστε την προστασία για να δείτε σε τι συνδέονται οι εφαρμογές σας."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার অ্যাপ্লিকেশানগুলি কিসের সাথে সংযুক্ত তা দেখতে সুরক্ষা চালু করুন৷"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapněte ochranu, abyste viděli, k čemu se vaše aplikace připojují."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota suojaus käyttöön nähdäksesi, mihin sovelluksesi muodostavat yhteyden."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી એપ્લિકેશનો શેનાથી કનેક્ટ થાય છે તે જોવા માટે સુરક્ષા ચાલુ કરો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह देखने के लिए सुरक्षा चालू करें कि आपके ऐप्स किससे कनेक्ट होते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uključite zaštitu da vidite na što se vaše aplikacije povezuju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå beskyttelse til for at se, hvad dine apps opretter forbindelse til."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan perlindungan untuk melihat aplikasi Anda terhubung ke mana."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保護をオンにして、アプリが何に接続しているかを確認します。"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsolja be a védelmet, hogy megtudja, mihez csatlakoznak alkalmazásai."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보호 기능을 켜서 앱이 무엇에 연결되어 있는지 확인하세요."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಅಪ್ಲಿಕೇಶನ್‌ಗಳು ಏನನ್ನು ಸಂಪರ್ಕಿಸುತ್ತವೆ ಎಂಬುದನ್ನು ನೋಡಲು ರಕ್ಷಣೆಯನ್ನು ಆನ್ ಮಾಡಿ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचे ॲप्स कशाशी कनेक्ट होतात हे पाहण्यासाठी संरक्षण चालू करा."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ആപ്പുകൾ കണക്‌റ്റ് ചെയ്യുന്നതെന്താണെന്ന് കാണാൻ പരിരക്ഷ ഓണാക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidupkan perlindungan untuk melihat sambungan apl anda."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel de beveiliging in om te zien waarmee uw apps verbinding maken."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କର ଆପ୍ କ’ଣ ସଂଯୋଗ ହୋଇଛି ତାହା ଦେଖିବା ପାଇଁ ସୁରକ୍ଷା ଟର୍ନ୍ ଅନ୍ କରନ୍ତୁ |"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਦੇਖਣ ਲਈ ਸੁਰੱਖਿਆ ਚਾਲੂ ਕਰੋ ਕਿ ਤੁਹਾਡੀਆਂ ਐਪਾਂ ਕੀ ਕਨੈਕਟ ਕਰਦੀਆਂ ਹਨ।"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på beskyttelse for å se hva appene dine kobler til."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz ochronę, aby zobaczyć, z czym łączą się Twoje aplikacje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative a proteção para ver a que seus aplicativos se conectam."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative a proteção para ver a que seus aplicativos se conectam."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activați protecția pentru a vedea la ce se conectează aplicațiile dvs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите защиту, чтобы увидеть, к чему подключаются ваши приложения."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vklopite zaščito, da vidite, s čim se povezujejo vaše aplikacije."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapnite ochranu, aby ste videli, k čomu sa vaše aplikácie pripájajú."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivera skydd för att se vad dina appar ansluter till."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் பயன்பாடுகள் எதனுடன் இணைக்கப்பட்டுள்ளன என்பதைப் பார்க்க பாதுகாப்பை இயக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดการป้องกันเพื่อดูว่าแอปของคุณเชื่อมต่อกับอะไร"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ యాప్‌లు దేనికి కనెక్ట్ అవుతున్నాయో చూడటానికి రక్షణను ఆన్ చేయండి."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть захист, щоб побачити, до чого підключаються ваші програми."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ دیکھنے کے لیے تحفظ کو آن کریں کہ آپ کی ایپس کس سے منسلک ہیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开保护以查看您的应用程序连接到的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟保護以查看您的應用程式連接到的內容。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật tính năng bảo vệ để xem ứng dụng của bạn kết nối với cái gì."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamalarınızın neye bağlandığını görmek için korumayı açın."
          }
        }
      }
    },
