        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τομείς ηλεκτρονικού ψαρέματος (phishing), απάτης και κακόβουλου λογισμικού εμφανίστηκαν πρόσφατα."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফিশিং, স্ক্যাম এবং ম্যালওয়্যার ডোমেন সম্প্রতি দেখা গেছে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
