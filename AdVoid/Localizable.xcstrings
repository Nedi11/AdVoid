    "Add any list by link. It updates along with the built-in lists." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge beliebige Listen per Link hinzu. Sie werden zusammen mit den integrierten Listen aktualisiert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez n’importe quelle liste par lien. Elle se met à jour avec les listes intégrées."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade cualquier lista mediante un enlace. Se actualiza junto con las listas integradas."
