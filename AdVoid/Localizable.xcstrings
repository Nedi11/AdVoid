          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تركز الإعلانات المحافظة وقائمة التتبع على عدم الكسر."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Anuncis conservadors i llista de seguiment centrats en zero trencaments."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι συντηρητικές διαφημίσεις και η λίστα παρακολούθησης επικεντρώνονται στη μηδενική θραύση."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রক্ষণশীল বিজ্ঞাপন এবং ট্র্যাকিং তালিকা শূন্য ভাঙার উপর দৃষ্টি নিবদ্ধ করে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Konzervativní reklamy a sledovací seznam zaměřený na nulové poškození."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Konservatiiviset mainokset ja seurantaluettelo keskittyvät nollakatkoisuuteen."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "રૂઢિચુસ્ત જાહેરાતો અને ટ્રેકિંગ સૂચિ શૂન્ય તૂટવા પર કેન્દ્રિત છે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रूढ़िवादी विज्ञापन और ट्रैकिंग सूची शून्य टूट-फूट पर केंद्रित है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konzervativni oglasi i popis za praćenje usmjereni su na nula kvarova."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Konservative annoncer og sporingsliste fokuseret på nul brud."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Iklan konservatif dan daftar pelacakan berfokus pada nihil kerusakan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "破損ゼロを重視した保守的な広告と追跡リスト。"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A konzervatív hirdetések és a követési lista a törésmentességre összpontosít."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파손 제로에 초점을 맞춘 보수적인 광고 및 추적 목록."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕನ್ಸರ್ವೇಟಿವ್ ಜಾಹೀರಾತುಗಳು ಮತ್ತು ಟ್ರ್ಯಾಕಿಂಗ್ ಪಟ್ಟಿ ಶೂನ್ಯ ಒಡೆಯುವಿಕೆಯ ಮೇಲೆ ಕೇಂದ್ರೀಕರಿಸಿದೆ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पुराणमतवादी जाहिराती आणि ट्रॅकिंग सूची शून्य मोडतोडवर केंद्रित आहे."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കൺസർവേറ്റീവ് പരസ്യങ്ങളും ട്രാക്കിംഗ് ലിസ്റ്റും സീറോ ബ്രേക്കേജിൽ ശ്രദ്ധ കേന്ദ്രീകരിച്ചു."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Iklan konservatif dan senarai penjejakan memfokuskan pada kerosakan sifar."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservatieve advertenties en trackinglijst gericht op nul breuk."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସଂରକ୍ଷଣ ବିଜ୍ ads ାପନ ଏବଂ ଟ୍ରାକିଂ ତାଲିକା ଶୂନ୍ୟ ଭାଙ୍ଗିବା ଉପରେ ଧ୍ୟାନ ଦେଇଥିଲେ |"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੰਜ਼ਰਵੇਟਿਵ ਵਿਗਿਆਪਨ ਅਤੇ ਟਰੈਕਿੰਗ ਸੂਚੀ ਜ਼ੀਰੋ ਟੁੱਟਣ 'ਤੇ ਕੇਂਦਰਿਤ ਹੈ।"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Konservative annonser og sporingsliste fokusert på null brudd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konserwatywne reklamy i lista śledzenia skupione na zerowym uszkodzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anúncios conservadores e lista de rastreamento com foco em quebra zero."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Anúncios conservadores e lista de rastreamento com foco em quebra zero."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclame conservatoare și listă de urmărire axate pe zero spargere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Консервативная реклама и список отслеживания ориентированы на отсутствие поломок."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konzervativni oglasi in seznam za sledenje, osredotočeni na nič zloma."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Konzervatívne reklamy a sledovací zoznam zameraný na nulové poškodenie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Konservativa annonser och spårningslista fokuserade på noll brott."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பழமைவாத விளம்பரங்கள் மற்றும் கண்காணிப்பு பட்டியல் பூஜ்ஜிய உடைப்பில் கவனம் செலுத்துகிறது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โฆษณาแบบอนุรักษ์นิยมและรายการติดตามมุ่งเน้นไปที่การแตกหักเป็นศูนย์"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సాంప్రదాయిక ప్రకటనలు మరియు ట్రాకింగ్ జాబితా సున్నా విచ్ఛిన్నంపై దృష్టి సారించాయి."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Консервативні оголошення та список відстеження зосереджені на нульовій поломці."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "قدامت پسند اشتہارات اور ٹریکنگ کی فہرست صفر ٹوٹ پھوٹ پر مرکوز ہے۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保守的广告和跟踪列表侧重于零破损。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保守的廣告和追蹤清單著重於零破損。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quảng cáo thận trọng và danh sách theo dõi tập trung vào việc không bị hỏng hóc."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Muhafazakar reklamlar ve takip listesi sıfır kırılmaya odaklandı."
          }
        }
      }
