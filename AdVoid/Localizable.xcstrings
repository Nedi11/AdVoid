        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube a některé další aplikace zobrazují reklamy ze stejných serverů jako jejich obsah. Blokování těchto serverů by také rozbilo aplikaci."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube ja jotkut muut sovellukset näyttävät mainoksia samoista palvelimista kuin niiden sisältö. Näiden palvelimien estäminen rikkoisi myös sovelluksen."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube અને કેટલીક અન્ય એપ્લિકેશનો તેમની સામગ્રી તરીકે સમાન સર્વર પરથી જાહેરાતો આપે છે. તે સર્વરને અવરોધિત કરવાથી એપ્લિકેશન પણ તૂટી જશે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube और कुछ अन्य ऐप्स अपनी सामग्री के समान सर्वर से विज्ञापन पेश करते हैं। उन सर्वरों को ब्लॉक करने से ऐप भी टूट जाएगा।"
