    "Your iPhone will ask to add a VPN. Tap Allow so AdVoid can work.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein iPhone fragt, ob ein VPN hinzugefügt werden soll. Tippe auf „Erlauben“, damit AdVoid funktioniert."
          }
        },
        "es": {
