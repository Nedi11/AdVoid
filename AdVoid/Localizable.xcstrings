    },
    "Lookups that aren't blocked are sent here, encrypted with DNS-over-HTTPS. On networks that block it, lookups fail rather than go out unencrypted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht blockierte Anfragen werden per DNS-over-HTTPS verschlüsselt hierhin gesendet. In Netzwerken, die das sperren, schlagen Anfragen fehl, statt unverschlüsselt rauszugehen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les requêtes non bloquées sont envoyées ici, chiffrées avec DNS-over-HTTPS. Sur les réseaux qui le bloquent, elles échouent plutôt que de partir sans chiffrement."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las consultas no bloqueadas se envían aquí, cifradas con DNS-over-HTTPS. En las redes que lo bloquean, las consultas fallan en vez de salir sin cifrar."
          }
        }
      }
    },
    "Lookups that aren't blocked are sent here, encrypted with DNS-over-HTTPS. On networks that block it, they're sent unencrypted instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht blockierte Anfragen werden per DNS-over-HTTPS verschlüsselt hierhin gesendet. In Netzwerken, die das sperren, werden sie stattdessen unverschlüsselt gesendet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les requêtes non bloquées sont envoyées ici, chiffrées avec DNS-over-HTTPS. Sur les réseaux qui le bloquent, elles sont envoyées sans chiffrement."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
