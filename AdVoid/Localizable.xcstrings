        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لنک کے ذریعے کوئی بھی فہرست شامل کریں۔ یہ بلٹ ان فہرستوں کے ساتھ اپ ڈیٹ ہوتا ہے۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
