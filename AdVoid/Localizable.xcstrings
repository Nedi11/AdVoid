        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Cloudflare Family blokkolja a rosszindulatú programokat és a felnőtteknek szánt webhelyeket is."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Family는 악성 코드와 성인 사이트도 차단합니다."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Family ಮಾಲ್‌ವೇರ್ ಮತ್ತು ವಯಸ್ಕರ ಸೈಟ್‌ಗಳನ್ನು ಸಹ ನಿರ್ಬಂಧಿಸುತ್ತದೆ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Family मालवेअर आणि प्रौढ साइट देखील अवरोधित करते."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Family ക്ഷുദ്രവെയറുകളെയും മുതിർന്നവരുടെ സൈറ്റുകളെയും തടയുന്നു."
          }
