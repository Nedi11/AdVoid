        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "AdVoid compileert deze blokkeerlijsten in zijn eigen formaat en distribueert ze opnieuw onder hun oorspronkelijke licenties. Alle eer voor de lijsten gaat naar de beheerders ervan."
