          "stringUnit": {
            "state": "translated",
            "value": "최근에 발견된 피싱, 사기, 악성코드 도메인."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫಿಶಿಂಗ್, ಸ್ಕ್ಯಾಮ್ ಮತ್ತು ಮಾಲ್‌ವೇರ್ ಡೊಮೇನ್‌ಗಳು ಇತ್ತೀಚೆಗೆ ಕಂಡುಬಂದಿವೆ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फिशिंग, घोटाळा आणि मालवेअर डोमेन अलीकडे पाहिले."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അടുത്തിടെ കണ്ട ഫിഷിംഗ്, സ്‌കാം, ക്ഷുദ്രവെയർ ഡൊമെയ്‌നുകൾ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Domain pancingan data, penipuan dan perisian hasad dilihat baru-baru ini."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Phishing-, oplichtings- en malwaredomeinen die onlangs zijn waargenomen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ନିକଟରେ ଦେଖାଯାଇଥିବା ଫିସିଂ, ସ୍କାମ ଏବଂ ମାଲୱେର୍ ଡୋମେନ୍ |"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫਿਸ਼ਿੰਗ, ਘੁਟਾਲੇ ਅਤੇ ਮਾਲਵੇਅਰ ਡੋਮੇਨ ਹਾਲ ਹੀ ਵਿੱਚ ਦੇਖੇ ਗਏ ਹਨ।"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettfisking, svindel og skadevaredomener som er sett nylig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatnio obserwowane domeny phishingowe, oszustwa i złośliwe oprogramowanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Domínios de phishing, fraude e malware vistos recentemente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Domínios de phishing, fraude e malware vistos recentemente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Domenii de phishing, escrocherie și malware văzute recent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недавно были замечены домены фишинга, мошенничества и вредоносного ПО."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedavno opažene domene lažnega predstavljanja, prevare in zlonamerne programske opreme."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Domény neoprávneného získavania údajov, podvodov a škodlivého softvéru, ktoré boli nedávno zaznamenané."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nätfiske, bedrägeri och skadliga domäner som har setts nyligen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஃபிஷிங், மோசடி மற்றும் மால்வேர் டொமைன்கள் சமீபத்தில் காணப்பட்டன."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โดเมนฟิชชิ่ง สแกม และมัลแวร์ที่พบเมื่อเร็วๆ นี้"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫిషింగ్, స్కామ్ మరియు మాల్వేర్ డొమైన్‌లు ఇటీవల కనిపించాయి."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нещодавно помічені домени фішингу, шахрайства та зловмисного програмного забезпечення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "حال ہی میں دیکھے گئے فشنگ، گھوٹالے اور میلویئر ڈومینز۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近发现的网络钓鱼、诈骗和恶意软件域。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最近發現的網路釣魚、詐騙和惡意軟體網域。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các miền lừa đảo, lừa đảo và phần mềm độc hại được thấy gần đây."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son zamanlarda görülen kimlik avı, dolandırıcılık ve kötü amaçlı yazılım alanları."
          }
        }
      }
    },
