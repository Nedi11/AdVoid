    "Apps that use their own encrypted DNS, and Safari with iCloud Private Relay on. iOS runs one VPN at a time, so another VPN turns AdVoid off.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps mit eigenem verschlüsseltem DNS sowie Safari mit aktiviertem iCloud Privat-Relay. iOS führt immer nur ein VPN aus, ein anderes VPN schaltet AdVoid also aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps que usan su propio DNS cifrado, y Safari con Relay privado de iCloud activado. iOS ejecuta una sola VPN a la vez, así que otra VPN desactiva AdVoid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps qui utilisent leur propre DNS chiffré, et Safari avec le relais privé iCloud activé. iOS n’exécute qu’un VPN à la fois : un autre VPN désactive AdVoid."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le app che usano un proprio DNS crittografato e Safari con il relay privato iCloud attivo. iOS esegue una sola VPN alla volta, quindi un'altra VPN disattiva AdVoid."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps that use their own encrypted DNS, and Safari with iCloud Private Relay on. iOS runs one VPN at a time, so another VPN turns AdVoid off."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps that use their own encrypted DNS, and Safari with iCloud Private Relay on. iOS runs one VPN at a time, so another VPN turns AdVoid off."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps that use their own encrypted DNS, and Safari with iCloud Private Relay on. iOS runs one VPN at a time, so another VPN turns AdVoid off."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps que usan su propio DNS cifrado, y Safari con Relay privado de iCloud activado. iOS ejecuta una sola VPN a la vez, así que otra VPN desactiva AdVoid."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps qui utilisent leur propre DNS chiffré, et Safari avec le relais privé iCloud activé. iOS n’exécute qu’un VPN à la fois : un autre VPN désactive AdVoid."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التطبيقات التي تستخدم DNS المشفرة الخاصة بها، وSafari مع تشغيل iCloud Private Relay. يقوم iOS بتشغيل VPN واحد في كل مرة، لذلك يقوم VPN آخر بإيقاف تشغيل AdVoid."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicacions que utilitzen el seu propi DNS encriptat i Safari amb iCloud Private Relay activat. iOS executa un VPN alhora, de manera que un altre VPN desactiva AdVoid."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εφαρμογές που χρησιμοποιούν το δικό τους κρυπτογραφημένο DNS και Safari με ενεργοποιημένο το iCloud Private Relay. Το iOS εκτελεί ένα VPN κάθε φορά, επομένως ένα άλλο VPN απενεργοποιεί το AdVoid."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যে অ্যাপগুলি iCloud Private Relay চালু সহ তাদের নিজস্ব এনক্রিপ্ট করা DNS এবং Safari ব্যবহার করে৷ iOS একবারে একটি VPN চালায়, তাই আরেকটি VPN AdVoid বন্ধ করে দেয়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace, které používají své vlastní šifrované DNS a Safari se zapnutým iCloud Private Relay. iOS běží po jednom VPN, takže další VPN vypne AdVoid."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovellukset, jotka käyttävät omaa salattua DNS:tä ja Safari:tä iCloud Private Relay:n ollessa päällä. iOS käyttää yhtä VPN:tä kerrallaan, joten toinen VPN sammuttaa AdVoid:n."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "એપ્લિકેશન્સ કે જેઓ iCloud Private Relay ચાલુ સાથે તેમના પોતાના એન્ક્રિપ્ટેડ DNS અને Safari નો ઉપયોગ કરે છે. iOS એક સમયે એક VPN ચલાવે છે, તેથી અન્ય VPN AdVoid બંધ કરે છે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐसे ऐप्स जो iCloud Private Relay के साथ अपने स्वयं के एन्क्रिप्टेड DNS और Safari का उपयोग करते हैं। iOS एक समय में एक VPN चलाता है, इसलिए दूसरा VPN AdVoid को बंद कर देता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacije koje koriste vlastiti šifrirani DNS i Safari s uključenim iCloud Private Relay. iOS pokreće jedan po jedan VPN, tako da drugi VPN isključuje AdVoid."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps, der bruger deres egen krypterede DNS og Safari med iCloud Private Relay tændt. iOS kører en VPN ad gangen, så en anden VPN slår AdVoid fra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi yang menggunakan DNS terenkripsi dan Safari dengan iCloud Private Relay aktif. iOS menjalankan VPN satu per satu, sehingga VPN yang lain akan mematikan AdVoid."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "独自の暗号化された DNS、および iCloud Private Relay をオンにした Safari を使用するアプリ。 iOS は一度に 1 つの VPN を実行するため、別の VPN は AdVoid をオフにします。"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Alkalmazások, amelyek saját titkosított DNS-t és Safari-t használnak bekapcsolt iCloud Private Relay-vel. A iOS egyszerre egy VPN-t futtat, tehát egy másik VPN kikapcsolja a AdVoid-t."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자체 암호화된 DNS 및 iCloud Private Relay가 켜진 Safari를 사용하는 앱입니다. iOS는 한 번에 하나의 VPN를 실행하므로 다른 VPN는 AdVoid를 끕니다."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Private Relay ಆನ್‌ನೊಂದಿಗೆ ತಮ್ಮದೇ ಆದ ಎನ್‌ಕ್ರಿಪ್ಟ್ ಮಾಡಿದ DNS ಮತ್ತು Safari ಅನ್ನು ಬಳಸುವ ಅಪ್ಲಿಕೇಶನ್‌ಗಳು. iOS ಒಂದು ಸಮಯದಲ್ಲಿ ಒಂದು VPN ರನ್ ಮಾಡುತ್ತದೆ, ಆದ್ದರಿಂದ ಮತ್ತೊಂದು VPN AdVoid ಅನ್ನು ಆಫ್ ಮಾಡುತ್ತದೆ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Private Relay चालू असलेले त्यांचे स्वतःचे एनक्रिप्ट केलेले DNS आणि Safari वापरणारे ॲप्स. iOS एका वेळी एक VPN चालवते, म्हणून दुसरे VPN AdVoid बंद करते."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്വന്തം എൻക്രിപ്റ്റ് ചെയ്ത DNS, iCloud Private Relay ഓണുള്ള Safari എന്നിവ ഉപയോഗിക്കുന്ന ആപ്പുകൾ. iOS ഒരു സമയം ഒരു VPN പ്രവർത്തിപ്പിക്കുന്നു, അതിനാൽ മറ്റൊരു VPN AdVoid ഓഫാക്കുന്നു."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apl yang menggunakan DNS yang disulitkan sendiri dan Safari dengan iCloud Private Relay dihidupkan. iOS menjalankan satu VPN pada satu masa, jadi VPN yang lain mematikan AdVoid."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps die hun eigen gecodeerde DNS gebruiken, en Safari met iCloud Private Relay ingeschakeld. iOS voert één VPN tegelijk uit, dus een andere VPN schakelt AdVoid uit."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଗୁଡ଼ିକ ଯାହା ସେମାନଙ୍କର ନିଜସ୍ୱ ଏନକ୍ରିପ୍ଟ ହୋଇଥିବା DNS, ଏବଂ iCloud Private Relay ସହିତ Safari ବ୍ୟବହାର କରନ୍ତି | iOS ଗୋଟିଏ ଥରରେ ଗୋଟିଏ VPN ଚଲାଇଥାଏ, ତେଣୁ ଅନ୍ୟ VPN AdVoid ବନ୍ଦ କରିଦିଏ |"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਐਪਾਂ ਜੋ ਆਪਣੇ ਖੁਦ ਦੇ ਐਨਕ੍ਰਿਪਟਡ DNS, ਅਤੇ iCloud Private Relay ਚਾਲੂ ਨਾਲ Safari ਵਰਤਦੀਆਂ ਹਨ। iOS ਇੱਕ ਸਮੇਂ ਵਿੱਚ ਇੱਕ VPN ਚਲਾਉਂਦਾ ਹੈ, ਇਸਲਈ ਇੱਕ ਹੋਰ VPN AdVoid ਨੂੰ ਬੰਦ ਕਰ ਦਿੰਦਾ ਹੈ।"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apper som bruker sine egne krypterte DNS, og Safari med iCloud Private Relay på. iOS kjører én VPN om gangen, så en annen VPN slår av AdVoid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacje korzystające z własnych zaszyfrowanych DNS i Safari z włączonym iCloud Private Relay. iOS uruchamia jeden VPN na raz, więc inny VPN wyłącza AdVoid."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicativos que usam seu próprio DNS criptografado e Safari com iCloud Private Relay ativado. iOS executa um VPN por vez, então outro VPN desliga AdVoid."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicativos que usam seu próprio DNS criptografado e Safari com iCloud Private Relay ativado. iOS executa um VPN por vez, então outro VPN desliga AdVoid."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicații care folosesc propriul DNS criptat și Safari cu iCloud Private Relay activat. iOS rulează câte un VPN odată, așa că un alt VPN dezactivează AdVoid."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложения, использующие собственные зашифрованные DNS и Safari с включенным iCloud Private Relay. iOS одновременно запускает один VPN, поэтому другой VPN выключает AdVoid."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacije, ki uporabljajo lasten šifriran DNS in Safari z vklopljenim iCloud Private Relay. iOS poganja enega VPN naenkrat, tako da drugi VPN izklopi AdVoid."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikácie, ktoré používajú svoje vlastné šifrované DNS a Safari so zapnutým iCloud Private Relay. iOS spúšťa jeden VPN naraz, takže ďalší VPN vypne AdVoid."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appar som använder sina egna krypterade DNS och Safari med iCloud Private Relay på. iOS kör en VPN i taget, så en annan VPN stänger av AdVoid."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தங்கள் சொந்த என்க்ரிப்ட் செய்யப்பட்ட DNS மற்றும் Safari ஆகியவற்றை iCloud Private Relay இயக்கத்தில் பயன்படுத்தும் ஆப்ஸ். iOS ஒரு நேரத்தில் ஒரு VPN ஐ இயக்குகிறது, எனவே மற்றொரு VPN AdVoid ஐ முடக்குகிறது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปที่ใช้ DNS ที่เข้ารหัสของตนเอง และ Safari โดยเปิด iCloud Private Relay iOS รัน VPN ทีละตัว ดังนั้น VPN อีกตัวจะปิด AdVoid"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Private Relay ఆన్‌లో ఉన్న వారి స్వంత ఎన్‌క్రిప్టెడ్ DNS మరియు Safariని ఉపయోగించే యాప్‌లు. iOS ఒక సమయంలో ఒక VPNని అమలు చేస్తుంది, కాబట్టి మరొక VPN AdVoidని ఆఫ్ చేస్తుంది."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Програми, які використовують власні зашифровані DNS і Safari з увімкненим iCloud Private Relay. iOS запускає один VPN за раз, тому інший VPN вимикає AdVoid."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وہ ایپس جو iCloud Private Relay آن کے ساتھ اپنی انکرپٹ شدہ DNS، اور Safari استعمال کرتی ہیں۔ iOS ایک وقت میں ایک VPN چلاتا ہے، تو دوسرا VPN AdVoid کو آف کر دیتا ہے۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用自己的加密 DNS 和 Safari（启用 iCloud Private Relay）的应用程序。 iOS 一次运行一个 VPN，因此另一个 VPN 会关闭 AdVoid。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用自己的加密 DNS 和 Safari（啟用 iCloud Private Relay）的應用程式。 iOS 一次運行一個 VPN，因此另一個 VPN 會關閉 AdVoid。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các ứng dụng sử dụng DNS được mã hóa của riêng chúng và Safari khi bật iCloud Private Relay. iOS chạy một VPN mỗi lần, do đó một VPN khác sẽ tắt AdVoid."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi şifreli DNS ve iCloud Private Relay açıkken Safari'yi kullanan uygulamalar. iOS aynı anda bir VPN çalıştırır, dolayısıyla başka bir VPN, AdVoid'yi kapatır."
          }
        }
      }
    },
