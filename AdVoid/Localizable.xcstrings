          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Commence à bloquer les publicités et traqueurs sur tout votre iPhone."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ في حظر الإعلانات وأجهزة التتبع عبر iPhone."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Comença a bloquejar anuncis i rastrejadors al vostre iPhone."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξεκινά να αποκλείει διαφημίσεις και προγράμματα παρακολούθησης στο iPhone."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার iPhone জুড়ে বিজ্ঞাপন এবং ট্র্যাকার ব্লক করা শুরু করে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spustí blokování reklam a sledovačů ve vašem iPhone."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Alkaa estää mainoksia ja seurantalaitteita iPhone:ssä."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા iPhone પર જાહેરાતો અને ટ્રેકર્સને અવરોધિત કરવાનું શરૂ કરે છે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके iPhone पर विज्ञापनों और ट्रैकर्स को ब्लॉक करना प्रारंभ करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Počinje blokirati oglase i praćenje na vašem iPhone."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Begynder at blokere annoncer og trackere på tværs af din iPhone."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai memblokir iklan dan pelacak di seluruh iPhone Anda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 全体で広告とトラッカーのブロックを開始します。"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elkezdi blokkolni a hirdetéseket és a nyomkövetőket a iPhone eszközön."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone에서 광고 및 추적기를 차단하기 시작합니다."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ iPhone ನಾದ್ಯಂತ ಜಾಹೀರಾತುಗಳು ಮತ್ತು ಟ್ರ್ಯಾಕರ್‌ಗಳನ್ನು ನಿರ್ಬಂಧಿಸಲು ಪ್ರಾರಂಭಿಸುತ್ತದೆ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या iPhone वर जाहिराती आणि ट्रॅकर्स ब्लॉक करणे सुरू होते."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ iPhone-ൽ ഉടനീളം പരസ്യങ്ങളും ട്രാക്കറുകളും തടയാൻ തുടങ്ങുന്നു."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mula menyekat iklan dan penjejak merentas iPhone anda."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Begint met het blokkeren van advertenties en trackers op uw iPhone."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କର iPhone ରେ ବିଜ୍ଞାପନ ଏବଂ ଟ୍ରାକରକୁ ଅବରୋଧ କରିବା ଆରମ୍ଭ କରେ |"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੇ iPhone ਵਿੱਚ ਇਸ਼ਤਿਹਾਰਾਂ ਅਤੇ ਟਰੈਕਰਾਂ ਨੂੰ ਬਲੌਕ ਕਰਨਾ ਸ਼ੁਰੂ ਕਰਦਾ ਹੈ।"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Begynner å blokkere annonser og sporere på tvers av iPhone."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoczyna blokowanie reklam i modułów śledzących w całym iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Começa a bloquear anúncios e rastreadores em seu iPhone."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Começa a bloquear anúncios e rastreadores em seu iPhone."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Începe să blocheze reclamele și instrumentele de urmărire pe iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начинает блокировать рекламу и трекеры на вашем iPhone."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Začne blokirati oglase in sledilnike v vašem iPhone."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Spustí blokovanie reklám a sledovačov vo vašom iPhone."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Börjar blockera annonser och spårare över din iPhone."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் iPhone முழுவதும் விளம்பரங்கள் மற்றும் டிராக்கர்களைத் தடுக்கத் தொடங்குகிறது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มบล็อกโฆษณาและเครื่องมือติดตามทั่ว iPhone ของคุณ"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ iPhone అంతటా ప్రకటనలు మరియు ట్రాకర్‌లను నిరోధించడం ప్రారంభిస్తుంది."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Починає блокувати рекламу та трекери на вашому iPhone."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے iPhone پر اشتہارات اور ٹریکرز کو مسدود کرنا شروع کرتا ہے۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始拦截 iPhone 上的广告和跟踪器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始攔截 iPhone 上的廣告和追蹤器。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu chặn quảng cáo và trình theo dõi trên iPhone của bạn."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone cihazınızda reklamları ve izleyicileri engellemeye başlar."
          }
        }
      }
