        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrupados a partir de dominios bloqueados que pertenecen a conocidas empresas de publicidad y análisis."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Regroupés à partir des domaines bloqués appartenant à des sociétés connues de publicité et d’analyse."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تجميعها من النطاقات المحظورة التي تنتمي إلى شركات الإعلانات والتحليلات المعروفة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrupats a partir de dominis bloquejats que pertanyen a empreses d'anàlisi i publicitat conegudes."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ομαδοποιούνται από αποκλεισμένους τομείς που ανήκουν σε γνωστές εταιρείες διαφημίσεων και αναλυτικών στοιχείων."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্লক করা ডোমেনগুলি থেকে গোষ্ঠীবদ্ধ যা সুপরিচিত বিজ্ঞাপন এবং বিশ্লেষণ কোম্পানিগুলির অন্তর্গত৷"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Seskupené z blokovaných domén, které patří známým reklamním a analytickým společnostem."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ryhmitetty estetyistä verkkotunnuksista, jotka kuuluvat tunnetuille mainos- ja analytiikkayrityksille."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જાણીતી જાહેરાત અને એનાલિટિક્સ કંપનીઓના અવરોધિત ડોમેન્સમાંથી જૂથબદ્ધ."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अवरुद्ध डोमेन से समूहीकृत जो प्रसिद्ध विज्ञापन और विश्लेषण कंपनियों से संबंधित हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grupirano iz blokiranih domena koje pripadaju poznatim tvrtkama za oglašavanje i analitiku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Grupperet fra blokerede domæner, der tilhører velkendte annonce- og analysevirksomheder."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikelompokkan dari domain yang diblokir milik perusahaan iklan dan analitik terkenal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有名な広告会社および分析会社に属するブロックされたドメインからグループ化されています。"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Olyan blokkolt domainekből csoportosítva, amelyek jól ismert hirdetési és elemző cégekhez tartoznak."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잘 알려진 광고 및 분석 회사에 속한 차단된 도메인으로 그룹화되었습니다."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರಸಿದ್ಧ ಜಾಹೀರಾತು ಮತ್ತು ವಿಶ್ಲೇಷಣಾ ಕಂಪನಿಗಳಿಗೆ ಸೇರಿದ ನಿರ್ಬಂಧಿಸಲಾದ ಡೊಮೇನ್‌ಗಳಿಂದ ಗುಂಪು ಮಾಡಲಾಗಿದೆ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सुप्रसिद्ध जाहिरात आणि विश्लेषण कंपन्यांशी संबंधित ब्लॉक केलेल्या डोमेनमधून गटबद्ध."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അറിയപ്പെടുന്ന പരസ്യ, അനലിറ്റിക്‌സ് കമ്പനികളുടെ ബ്ലോക്ക് ചെയ്‌ത ഡൊമെയ്‌നുകളിൽ നിന്ന് ഗ്രൂപ്പ് ചെയ്‌തിരിക്കുന്നു."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dihimpunkan daripada domain yang disekat yang dimiliki oleh syarikat iklan dan analitis yang terkenal."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Gegroepeerd uit geblokkeerde domeinen die toebehoren aan bekende advertentie- en analysebedrijven."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଅବରୋଧିତ ଡୋମେନଗୁଡିକରୁ ଗ୍ରୁପ୍ ହୋଇଛି ଯାହା ଜଣାଶୁଣା ବିଜ୍ଞାପନ ଏବଂ ଆନାଲିଟିକ୍ସ କମ୍ପାନୀଗୁଡିକର ଅଟେ |"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਬਲੌਕ ਕੀਤੇ ਡੋਮੇਨਾਂ ਤੋਂ ਸਮੂਹ ਕੀਤਾ ਗਿਆ ਹੈ ਜੋ ਮਸ਼ਹੂਰ ਵਿਗਿਆਪਨ ਅਤੇ ਵਿਸ਼ਲੇਸ਼ਣ ਕੰਪਨੀਆਂ ਨਾਲ ਸਬੰਧਤ ਹਨ।"
          }
        },
        "nb": {
