        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν μπλοκάρεται τίποτα. Ενεργοποιήστε μια λίστα αποκλεισμού, προσθέστε τους δικούς σας ή αποκλείστε τομείς στις Ρυθμίσεις."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কিছুই আটকানো হচ্ছে না। একটি ব্লকলিস্ট চালু করুন, আপনার নিজের যোগ করুন বা সেটিংসে ডোমেন ব্লক করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic není blokováno. Zapněte blokovaný seznam, přidejte vlastní nebo zablokujte domény v Nastavení."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitään ei ole estetty. Ota estolista käyttöön, lisää omasi tai estä verkkotunnukset asetuksista."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કંઈપણ અવરોધિત કરવામાં આવી રહ્યું નથી. બ્લોકલિસ્ટ ચાલુ કરો, તમારું પોતાનું ઉમેરો અથવા સેટિંગ્સમાં ડોમેન્સ બ્લોક કરો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ भी अवरुद्ध नहीं किया जा रहा है. सेटिंग्स में ब्लॉकलिस्ट चालू करें, अपना खुद का जोड़ें या डोमेन ब्लॉक करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ništa se ne blokira. Uključite popis blokiranih, dodajte vlastite ili blokirajte domene u Postavkama."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet bliver blokeret. Slå en blokeringsliste til, tilføj dine egne, eller bloker domæner i Indstillinger."
