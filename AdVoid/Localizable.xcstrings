          "stringUnit": {
            "state": "translated",
            "value": "Grupate din domenii blocate care aparțin unor companii renumite de reclame și analize."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сгруппированы из заблокированных доменов, принадлежащих известным рекламным и аналитическим компаниям."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbrane iz blokiranih domen, ki pripadajo znanim oglaševalskim in analitičnim podjetjem."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoskupené z blokovaných domén, ktoré patria známym reklamným a analytickým spoločnostiam."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Grupperas från blockerade domäner som tillhör välkända annons- och analysföretag."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நன்கு அறியப்பட்ட விளம்பரம் மற்றும் பகுப்பாய்வு நிறுவனங்களுக்குச் சொந்தமான தடுக்கப்பட்ட டொமைன்களிலிருந்து குழுவாக்கப்பட்டது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จัดกลุ่มจากโดเมนที่ถูกบล็อกซึ่งเป็นของบริษัทโฆษณาและการวิเคราะห์ที่มีชื่อเสียง"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రసిద్ధ ప్రకటన మరియు విశ్లేషణల కంపెనీలకు చెందిన బ్లాక్ చేయబడిన డొమైన్‌ల నుండి సమూహం చేయబడింది."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Згруповані із заблокованих доменів, які належать відомим рекламним і аналітичним компаніям."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بلاک شدہ ڈومینز سے گروپ کیا گیا جو معروف اشتہار اور تجزیاتی کمپنیوں سے تعلق رکھتے ہیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从属于知名广告和分析公司的被阻止域分组。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從屬於知名廣告和分析公司的被阻止網域分組。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được nhóm từ các miền bị chặn thuộc về các công ty phân tích và quảng cáo nổi tiếng."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanınmış reklam ve analiz şirketlerine ait engellenen alanlardan gruplandırılmıştır."
          }
        }
      }
    },
