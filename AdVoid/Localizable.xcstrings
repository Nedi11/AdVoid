    "The Simulator can't run VPNs. Run AdVoid on an iPhone to turn on protection.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Simulator kann keine VPNs ausführen. Starte AdVoid auf einem iPhone, um den Schutz zu aktivieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Simulador no puede ejecutar VPN. Abre AdVoid en un iPhone para activar la protección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Simulateur ne peut pas exécuter de VPN. Lancez AdVoid sur un iPhone pour activer la protection."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il simulatore non può eseguire VPN. Esegui AdVoid su un iPhone per attivare la protezione."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "The Simulator can't run VPNs. Run AdVoid on an iPhone to turn on protection."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "The Simulator can't run VPNs. Run AdVoid on an iPhone to turn on protection."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The Simulator can't run VPNs. Run AdVoid on an iPhone to turn on protection."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El Simulador no puede ejecutar VPN. Abre AdVoid en un iPhone para activar la protección."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Simulateur ne peut pas exécuter de VPN. Lancez AdVoid sur un iPhone pour activer la protection."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع جهاز المحاكاة تشغيل VPNs. قم بتشغيل AdVoid على iPhone لتشغيل الحماية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El simulador no pot executar VPN. Executeu AdVoid en un iPhone per activar la protecció."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο προσομοιωτής δεν μπορεί να εκτελέσει VPN. Εκτελέστε το AdVoid σε ένα iPhone για να ενεργοποιήσετε την προστασία."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সিমুলেটর VPN চালাতে পারে না। সুরক্ষা চালু করতে একটি iPhone এ AdVoid চালান।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulátor nemůže spustit VPN. Spuštěním AdVoid na iPhone zapněte ochranu."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulaattori ei voi ajaa VPN:itä. Käynnistä suojaus ajamalla AdVoid iPhone:ssä."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સિમ્યુલેટર VPN ચલાવી શકતું નથી. સુરક્ષા ચાલુ કરવા માટે iPhone પર AdVoid ચલાવો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिम्युलेटर VPNs नहीं चला सकता। सुरक्षा चालू करने के लिए iPhone पर AdVoid चलाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulator ne može pokretati VPNs. Pokrenite AdVoid na iPhone da uključite zaštitu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulatoren kan ikke køre VPNs. Kør AdVoid på en iPhone for at aktivere beskyttelse."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulator tidak dapat menjalankan VPN. Jalankan AdVoid pada iPhone untuk mengaktifkan perlindungan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シミュレーターは VPN を実行できません。 iPhone 上で AdVoid を実行して、保護をオンにします。"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szimulátor nem tudja futtatni a VPN-ket. Futtassa a AdVoid-t egy iPhone-n a védelem bekapcsolásához."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시뮬레이터는 VPN를 실행할 수 없습니다. 보호 기능을 켜려면 iPhone에서 AdVoid를 실행하세요."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಿಮ್ಯುಲೇಟರ್ VPN ಗಳನ್ನು ರನ್ ಮಾಡಲು ಸಾಧ್ಯವಿಲ್ಲ. ರಕ್ಷಣೆಯನ್ನು ಆನ್ ಮಾಡಲು iPhone ನಲ್ಲಿ AdVoid ರನ್ ಮಾಡಿ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सिम्युलेटर VPNs चालवू शकत नाही. संरक्षण चालू करण्यासाठी iPhone वर AdVoid चालवा."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സിമുലേറ്ററിന് VPN-കൾ പ്രവർത്തിപ്പിക്കാനാകില്ല. പരിരക്ഷ ഓണാക്കാൻ iPhone-ൽ AdVoid പ്രവർത്തിപ്പിക്കുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulator tidak boleh menjalankan VPNs. Jalankan AdVoid pada iPhone untuk menghidupkan perlindungan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "De simulator kan geen VPN's uitvoeren. Voer AdVoid uit op een iPhone om de beveiliging in te schakelen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସିମୁଲେଟର VPN କୁ ଚଲାଇପାରିବ ନାହିଁ | ସୁରକ୍ଷା ଟର୍ନ୍ ଅନ୍ କରିବାକୁ AdVoid କୁ iPhone ଉପରେ ଚଲାନ୍ତୁ |"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਿਮੂਲੇਟਰ VPN ਨੂੰ ਨਹੀਂ ਚਲਾ ਸਕਦਾ। ਸੁਰੱਖਿਆ ਨੂੰ ਚਾਲੂ ਕਰਨ ਲਈ ਇੱਕ iPhone 'ਤੇ AdVoid ਚਲਾਓ।"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulatoren kan ikke kjøre VPNs. Kjør AdVoid på en iPhone for å slå på beskyttelse."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W symulatorze nie można uruchomić VPN. Uruchom AdVoid na iPhone, aby włączyć ochronę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Simulador não pode executar VPNs. Execute AdVoid em um iPhone para ativar a proteção."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Simulador não pode executar VPNs. Execute AdVoid em um iPhone para ativar a proteção."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulatorul nu poate rula VPN. Rulați AdVoid pe un iPhone pentru a activa protecția."
          }
        },
        "ru": {
