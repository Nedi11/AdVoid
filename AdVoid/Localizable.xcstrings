    "AdGuard's list for DNS-level ad and tracker blocking." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Liste von AdGuard zum Blockieren von Werbung und Trackern per DNS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lista de AdGuard para bloquear anuncios y rastreadores a nivel de DNS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La liste d’AdGuard pour bloquer pubs et traqueurs au niveau DNS."
          }
        }
      }
    },
    "Ads and trackers are blocked for all apps." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werbung und Tracker werden in allen Apps blockiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los anuncios y rastreadores están bloqueados en todas las apps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les publicités et traqueurs sont bloqués dans toutes les apps."
          }
        }
      }
    },
    "Ads, trackers, telemetry and malware. Well balanced, rarely breaks sites." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werbung, Tracker, Telemetrie und Malware. Ausgewogen, legt selten Websites lahm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anuncios, rastreadores, telemetría y malware. Equilibrada, rara vez estropea sitios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pubs, traqueurs, télémétrie et logiciels malveillants. Équilibrée, casse rarement les sites."
          }
        }
      }
    },
    "AdVoid" : {
      "shouldTranslate" : false
    },
    "AdVoid blocks ad and tracker domains across your apps and websites." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AdVoid blockiert Werbe- und Tracker-Domains in deinen Apps und auf Websites."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AdVoid bloquea dominios de anuncios y rastreadores en tus apps y sitios web."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AdVoid bloque les domaines publicitaires et de suivi dans vos apps et sur les sites web."
          }
        }
      }
    },
    "AdVoid can't reach its shared storage, so blocking rules can't be updated. Reinstalling AdVoid should fix this." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AdVoid kann nicht auf seinen gemeinsamen Speicher zugreifen, daher lassen sich die Blockierregeln nicht aktualisieren. Eine Neuinstallation von AdVoid sollte das beheben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AdVoid no puede acceder a su almacenamiento compartido, así que no se pueden actualizar las reglas de bloqueo. Reinstalar AdVoid debería solucionarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AdVoid n’accède pas à son stockage partagé, les règles de blocage ne peuvent donc pas être mises à jour. Réinstaller AdVoid devrait régler le problème."
          }
        }
      }
    },
    "AdVoid compiles these blocklists into its own format and redistributes them under their original licenses. All credit for the lists goes to their maintainers." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AdVoid wandelt diese Blocklisten in ein eigenes Format um und verbreitet sie unter ihren ursprünglichen Lizenzen weiter. Alle Anerkennung für die Listen gebührt ihren Betreuern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AdVoid compila estas listas de bloqueo en su propio formato y las redistribuye bajo sus licencias originales. Todo el mérito de las listas es de sus responsables."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AdVoid compile ces listes de blocage dans son propre format et les redistribue sous leurs licences d’origine. Tout le mérite des listes revient à leurs mainteneurs."
          }
        }
      }
    },
    "AdVoid runs a VPN on your iPhone that only looks at DNS, the lookups apps make before connecting. Lookups for ad and tracker domains get a dead end, so those requests never go out." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AdVoid betreibt auf deinem iPhone ein VPN, das nur DNS betrachtet – die Anfragen, die Apps vor dem Verbinden stellen. Anfragen an Werbe- und Tracker-Domains laufen ins Leere, sodass diese Verbindungen nie zustande kommen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AdVoid ejecuta en tu iPhone una VPN que solo mira el DNS, las consultas que hacen las apps antes de conectarse. Las consultas a dominios de anuncios y rastreadores no llevan a ninguna parte, así que esas conexiones nunca salen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AdVoid fait tourner sur votre iPhone un VPN qui ne regarde que le DNS, les requêtes que les apps font avant de se connecter. Les requêtes vers les domaines publicitaires et de suivi aboutissent à une impasse : ces connexions ne partent jamais."
          }
        }
      }
    },
