          "stringUnit": {
            "state": "translated",
            "value": "Nasıl çalışır?"
          }
        }
      }
    },
    "https://example.com/blocklist.txt": {
      "shouldTranslate": false
    },
    "If something stops working, find it in Activity and swipe to allow it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Funktioniert etwas nicht mehr, such es unter „Aktivität“ und wische, um es zu erlauben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si algo deja de funcionar, búscalo en Actividad y desliza para permitirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si quelque chose ne fonctionne plus, trouvez-le dans Activité et balayez pour l’autoriser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se qualcosa smette di funzionare, cercalo in Attività e scorri per consentirlo."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "If something stops working, find it in Activity and swipe to allow it."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "If something stops working, find it in Activity and swipe to allow it."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If something stops working, find it in Activity and swipe to allow it."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Si algo deja de funcionar, búscalo en Actividad y desliza para permitirlo."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Si quelque chose ne fonctionne plus, trouvez-le dans Activité et balayez pour l’autoriser."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا توقف شيء ما عن العمل، فابحث عنه في النشاط واسحب للسماح به."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si alguna cosa deixa de funcionar, cerca-la a Activitat i fes lliscar el dit per permetre-ho."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εάν κάτι σταματήσει να λειτουργεί, βρείτε το στη Δραστηριότητα και σύρετε για να το επιτρέψετε."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যদি কিছু কাজ করা বন্ধ করে দেয়, তবে এটিকে অ্যাক্টিভিটিতে খুঁজুন এবং অনুমতি দিতে সোয়াইপ করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud něco přestane fungovat, najděte to v Aktivitě a přejetím prstem to povolte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos jokin lakkaa toimimasta, etsi se toiminnoista ja salli se pyyhkäisemällä."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જો કંઈક કામ કરવાનું બંધ કરે, તો તેને પ્રવૃત્તિમાં શોધો અને તેને મંજૂરી આપવા માટે સ્વાઇપ કરો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि कोई चीज़ काम करना बंद कर देती है, तो उसे गतिविधि में ढूंढें और उसे अनुमति देने के लिए स्वाइप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako nešto prestane raditi, pronađite to u Aktivnosti i prijeđite prstom da biste to dopustili."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis noget holder op med at fungere, skal du finde det i Aktivitet og stryge for at tillade det."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika ada sesuatu yang berhenti berfungsi, temukan di Aktivitas dan geser untuk mengizinkannya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何かが動作しなくなった場合は、アクティビティでそれを見つけてスワイプして許可します。"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha valami nem működik, keresse meg a Tevékenységek között, és csúsztassa az ujját az engedélyezéshez."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작동이 중지된 경우 활동에서 해당 항목을 찾아 스와이프하여 허용하세요."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಏನಾದರೂ ಕೆಲಸ ಮಾಡುವುದನ್ನು ನಿಲ್ಲಿಸಿದರೆ, ಅದನ್ನು ಚಟುವಟಿಕೆಯಲ್ಲಿ ಹುಡುಕಿ ಮತ್ತು ಅದನ್ನು ಅನುಮತಿಸಲು ಸ್ವೈಪ್ ಮಾಡಿ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "काहीतरी काम करणे थांबवल्यास, ते क्रियाकलाप मध्ये शोधा आणि त्यास अनुमती देण्यासाठी स्वाइप करा."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എന്തെങ്കിലും പ്രവർത്തിക്കുന്നത് നിർത്തുകയാണെങ്കിൽ, അത് പ്രവർത്തനത്തിൽ കണ്ടെത്തി അത് അനുവദിക്കുന്നതിന് സ്വൈപ്പ് ചെയ്യുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika sesuatu berhenti berfungsi, cari dalam Aktiviti dan leret untuk membenarkannya."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Als iets niet meer werkt, zoek het dan op in Activiteit en veeg om het toe te staan."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଯଦି କିଛି କାମ ବନ୍ଦ କରିଦିଏ, ଏହାକୁ କାର୍ଯ୍ୟକଳାପରେ ଖୋଜ ଏବଂ ଏହାକୁ ଅନୁମତି ଦେବାକୁ ସ୍ୱାଇପ୍ କର |"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜੇਕਰ ਕੋਈ ਚੀਜ਼ ਕੰਮ ਕਰਨਾ ਬੰਦ ਕਰ ਦਿੰਦੀ ਹੈ, ਤਾਂ ਇਸਨੂੰ ਗਤੀਵਿਧੀ ਵਿੱਚ ਲੱਭੋ ਅਤੇ ਇਸਨੂੰ ਇਜਾਜ਼ਤ ਦੇਣ ਲਈ ਸਵਾਈਪ ਕਰੋ।"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis noe slutter å fungere, finner du det i Aktivitet og sveiper for å tillate det."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli coś przestanie działać, znajdź to w Aktywności i przesuń, aby na to pozwolić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se algo parar de funcionar, encontre-o em Atividade e deslize para permitir."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se algo parar de funcionar, encontre-o em Atividade e deslize para permitir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă ceva nu mai funcționează, găsiți-l în Activitate și glisați pentru a permite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если что-то перестает работать, найдите это в разделе «Активность» и проведите по экрану, чтобы разрешить это."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če nekaj preneha delovati, to poiščite v Dejavnosti in povlecite, da dovolite."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak niečo prestane fungovať, nájdite to v časti Aktivita a povoľte to potiahnutím prstom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om något slutar fungera, hitta det i Aktivitet och svep för att tillåta det."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஏதாவது வேலை செய்வதை நிறுத்தினால், அதை செயல்பாட்டில் கண்டறிந்து, அதை அனுமதிக்க ஸ்வைப் செய்யவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากมีบางอย่างหยุดทำงาน ให้ค้นหาสิ่งนั้นในกิจกรรมแล้วปัดเพื่ออนุญาต"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏదైనా పని చేయడం ఆపివేస్తే, దాన్ని యాక్టివిటీలో కనుగొని, దానిని అనుమతించడానికి స్వైప్ చేయండి."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо щось перестає працювати, знайдіть це в «Дії» та проведіть пальцем, щоб дозволити."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر کوئی چیز کام کرنا بند کر دیتی ہے تو اسے سرگرمی میں تلاش کریں اور اسے اجازت دینے کے لیے سوائپ کریں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果某些内容停止工作，请在“活动”中找到它并滑动以允许它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果某些內容停止工作，請在“活動”中找到它並滑動以允許它。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu có thứ gì đó ngừng hoạt động, hãy tìm nó trong Hoạt động và vuốt để cho phép."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir şey çalışmayı durdurursa bunu Etkinlik'te bulun ve izin vermek için kaydırın."
          }
        }
      }
    },
    "Just the built-in Essentials list is blocking. Turn on more blocklists, add your own, or block domains in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die integrierte Essentials-Liste blockiert. Aktiviere weitere Blocklisten, füge eigene hinzu oder blockiere Domains in den Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo bloquea la lista integrada Esenciales. Activa más listas, añade las tuyas o bloquea dominios en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seule la liste intégrée Essentiels bloque. Activez d’autres listes, ajoutez les vôtres ou bloquez des domaines dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È attiva solo la lista Essenziali integrata. Attiva altre liste, aggiungi le tue o blocca domini nelle impostazioni."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Just the built-in Essentials list is blocking. Turn on more blocklists, add your own, or block domains in Settings."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Just the built-in Essentials list is blocking. Turn on more blocklists, add your own, or block domains in Settings."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Just the built-in Essentials list is blocking. Turn on more blocklists, add your own, or block domains in Settings."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo bloquea la lista integrada Esenciales. Activa más listas, añade las tuyas o bloquea dominios en Ajustes."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Seule la liste intégrée Essentiels bloque. Activez d’autres listes, ajoutez les vôtres ou bloquez des domaines dans Réglages."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم حظر قائمة الأساسيات المضمنة فقط. قم بتشغيل المزيد من قوائم الحظر، أو قم بإضافة النطاقات الخاصة بك، أو قم بحظر النطاقات في الإعدادات."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només s'està bloquejant la llista d'elements bàsics integrada. Activeu més llistes de bloqueig, afegiu-ne les vostres o bloquegeu dominis a Configuració."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο η ενσωματωμένη λίστα Essentials μπλοκάρει. Ενεργοποιήστε περισσότερες λίστες αποκλεισμού, προσθέστε τους δικούς σας ή αποκλείστε τομείς στις Ρυθμίσεις."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু অন্তর্নির্মিত অপরিহার্য তালিকা ব্লক করা হয়. আরও ব্লকলিস্ট চালু করুন, আপনার নিজের যোগ করুন বা সেটিংসে ডোমেন ব্লক করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokuje pouze vestavěný seznam Essentials. V Nastavení zapněte další seznamy blokovaných položek, přidejte vlastní nebo blokujte domény."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain sisäänrakennettu Essentials-luettelo estää. Ota lisää estoluetteloita käyttöön, lisää omia tai estä verkkotunnuksia asetuksista."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બસ બિલ્ટ-ઇન એસેન્શિયલ્સ લિસ્ટ બ્લોક કરી રહ્યું છે. વધુ બ્લોકલિસ્ટ્સ ચાલુ કરો, તમારી પોતાની ઉમેરો અથવા સેટિંગ્સમાં ડોમેન્સ બ્લોક કરો."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बस अंतर्निहित अनिवार्य सूची अवरुद्ध हो रही है। सेटिंग्स में अधिक ब्लॉक सूचियाँ चालू करें, अपना खुद का जोड़ें, या डोमेन ब्लॉक करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo ugrađeni Essentials popis blokira. Uključite više popisa blokiranih, dodajte vlastite ili blokirajte domene u Postavkama."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare den indbyggede Essentials-liste blokerer. Slå flere blokeringslister til, tilføj dine egne eller bloker domæner i Indstillinger."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya daftar Essentials bawaan yang memblokir. Aktifkan lebih banyak daftar blokir, tambahkan domain Anda sendiri, atau blokir domain di Pengaturan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "組み込みの Essentials リストだけがブロックしています。設定でさらにブロックリストを有効にするか、独自のドメインを追加するか、ドメインをブロックします。"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak a beépített Essentials lista blokkol. Kapcsoljon be további tiltólistákat, vegye fel sajátját, vagy blokkoljon domaineket a Beállításokban."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내장된 필수 목록만 차단됩니다. 설정에서 더 많은 차단 목록을 활성화하거나 직접 추가하거나 도메인을 차단하세요."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕೇವಲ ಅಂತರ್ನಿರ್ಮಿತ ಅಗತ್ಯಗಳ ಪಟ್ಟಿಯನ್ನು ನಿರ್ಬಂಧಿಸಲಾಗುತ್ತಿದೆ. ಹೆಚ್ಚಿನ ಬ್ಲಾಕ್‌ಲಿಸ್ಟ್‌ಗಳನ್ನು ಆನ್ ಮಾಡಿ, ನಿಮ್ಮದೇ ಆದದನ್ನು ಸೇರಿಸಿ ಅಥವಾ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಡೊಮೇನ್‌ಗಳನ್ನು ನಿರ್ಬಂಧಿಸಿ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फक्त अंगभूत आवश्यक सूची ब्लॉक करत आहे. सेटिंग्जमध्ये आणखी ब्लॉकलिस्ट सुरू करा, तुमची स्वतःची जोडा किंवा डोमेन ब्लॉक करा."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ബിൽറ്റ്-ഇൻ എസൻഷ്യൽ ലിസ്റ്റ് തടയുന്നു. കൂടുതൽ ബ്ലോക്ക്‌ലിസ്റ്റുകൾ ഓണാക്കുക, നിങ്ങളുടേത് ചേർക്കുക അല്ലെങ്കിൽ ക്രമീകരണങ്ങളിൽ ഡൊമെയ്‌നുകൾ തടയുക."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya senarai Essentials terbina dalam yang menyekat. Hidupkan lebih banyak senarai sekat, tambah domain anda sendiri atau sekat domain dalam Tetapan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen de ingebouwde Essentials-lijst blokkeert. Schakel meer blokkeerlijsten in, voeg uw eigen lijsten toe of blokkeer domeinen in Instellingen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କେବଳ ବିଲ୍ଟ-ଇନ୍ ଏସେନସିଆଲ୍ସ ତାଲିକା ଅବରୋଧ କରୁଛି | ଅଧିକ ବ୍ଲକଲିଷ୍ଟ ଟର୍ନ୍ ଅନ୍ କରନ୍ତୁ, ଆପଣଙ୍କର ନିଜର ଯୋଡନ୍ତୁ, କିମ୍ବା ସେଟିଂସମୂହରେ ଡୋମେନ୍ଗୁଡ଼ିକୁ ଅବରୋଧ କରନ୍ତୁ |"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਬਸ ਬਿਲਟ-ਇਨ ਜ਼ਰੂਰੀ ਸੂਚੀ ਬਲੌਕ ਕਰ ਰਹੀ ਹੈ। ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਹੋਰ ਬਲੌਕਲਿਸਟਾਂ ਨੂੰ ਚਾਲੂ ਕਰੋ, ਆਪਣੀ ਖੁਦ ਦੀ ਜੋੜੋ, ਜਾਂ ਡੋਮੇਨਾਂ ਨੂੰ ਬਲੌਕ ਕਰੋ।"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare den innebygde Essentials-listen blokkerer. Slå på flere blokkeringslister, legg til dine egne eller blokker domener i Innstillinger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokuje się tylko wbudowana lista Essentials. Włącz więcej list zablokowanych, dodaj własne lub zablokuj domeny w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas a lista interna do Essentials está bloqueando. Ative mais listas de bloqueio, adicione as suas próprias ou bloqueie domínios em Configurações."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas a lista interna do Essentials está bloqueando. Ative mais listas de bloqueio, adicione as suas próprias ou bloqueie domínios em Configurações."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar lista încorporată Essentials se blochează. Activați mai multe liste de blocare, adăugați propriile domenii sau blocați domenii în Setări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокируется только встроенный список Essentials. Включите дополнительные черные списки, добавьте свои собственные или заблокируйте домены в настройках."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokira samo vgrajeni seznam Essentials. V nastavitvah vklopite več seznamov blokiranih, dodajte svoje ali blokirajte domene."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokuje iba vstavaný zoznam Essentials. Zapnite si ďalšie zoznamy blokovaných položiek, pridajte si vlastné alebo zablokujte domény v Nastaveniach."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara den inbyggda Essentials-listan blockerar. Aktivera fler blockeringslistor, lägg till dina egna eller blockera domäner i Inställningar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உள்ளமைக்கப்பட்ட எசென்ஷியல்ஸ் பட்டியல் தடுக்கிறது. மேலும் தடுப்புப்பட்டியலை இயக்கவும், உங்களுடையதைச் சேர்க்கவும் அல்லது அமைப்புகளில் டொமைன்களைத் தடுக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บล็อกเฉพาะรายการ Essentials ในตัวเท่านั้น เปิดรายการบล็อกเพิ่มเติม เพิ่มของคุณเอง หรือบล็อกโดเมนในการตั้งค่า"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అంతర్నిర్మిత ఎసెన్షియల్స్ జాబితా బ్లాక్ చేయబడుతోంది. మరిన్ని బ్లాక్‌లిస్ట్‌లను ఆన్ చేయండి, మీ స్వంతంగా జోడించండి లేదా సెట్టింగ్‌లలో డొమైన్‌లను బ్లాక్ చేయండి."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокує лише вбудований список Essentials. Увімкніть більше списків блокування, додайте власні або заблокуйте домени в налаштуваннях."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بس بلٹ ان لوازمات کی فہرست بلاک کر رہی ہے۔ مزید بلاک لسٹس کو آن کریں، اپنی اپنی شامل کریں، یا سیٹنگز میں ڈومینز بلاک کریں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有内置的 Essentials 列表会被阻止。打开更多阻止列表、添加您自己的列表或在“设置”中阻止域。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有內建的 Essentials 清單會被封鎖。開啟更多封鎖清單、新增您自己的清單或在「設定」中封鎖網域。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ có danh sách Essentials tích hợp đang chặn. Bật thêm danh sách chặn, thêm danh sách của riêng bạn hoặc chặn miền trong Cài đặt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca yerleşik Essentials listesi engelliyor. Ayarlar'da daha fazla engellenenler listesini açın, kendi listenizi ekleyin veya alan adlarını engelleyin."
          }
        }
      }
    },
