    "Blocking happens on your iPhone. We never see what you browse.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Blockieren passiert auf deinem iPhone. Wir sehen nie, was du aufrufst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El bloqueo ocurre en tu iPhone. Nunca vemos lo que navegas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le blocage se fait sur votre iPhone. Nous ne voyons jamais ce que vous consultez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il blocco avviene sul tuo iPhone. Non vediamo mai cosa visiti."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocking happens on your iPhone. We never see what you browse."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocking happens on your iPhone. We never see what you browse."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocking happens on your iPhone. We never see what you browse."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El bloqueo ocurre en tu iPhone. Nunca vemos lo que navegas."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le blocage se fait sur votre iPhone. Nous ne voyons jamais ce que vous consultez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحدث الحظر على iPhone الخاص بك. نحن لا نرى ما تتصفحه أبدًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El bloqueig es produeix al vostre iPhone. Mai veiem el que navegues."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο αποκλεισμός γίνεται στο iPhone. Δεν βλέπουμε ποτέ αυτό που περιηγείστε."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার iPhone এ ব্লক করা হয়। আপনি যা ব্রাউজ করেন তা আমরা কখনই দেখি না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokování se děje na vašem iPhone. Nikdy nevidíme, co prohlížíte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Estäminen tapahtuu iPhone:ssä. Emme koskaan näe mitä selaat."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બ્લોકીંગ તમારા iPhone પર થાય છે. તમે જે બ્રાઉઝ કરો છો તે અમે ક્યારેય જોતા નથી."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके iPhone पर ब्लॉकिंग होती है। हम कभी नहीं देखते कि आप क्या ब्राउज़ करते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokiranje se događa na vašem iPhone. Nikada ne vidimo ono što pregledavate."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokering sker på din iPhone. Vi ser aldrig, hvad du gennemser."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemblokiran terjadi di iPhone Anda. Kami tidak pernah melihat apa yang Anda jelajahi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone でブロックが発生します。あなたが閲覧したものを私たちが見ることはありません。"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A blokkolás a iPhone készüléken történik. Soha nem látjuk, amit böngész."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차단은 iPhone에서 발생합니다. 우리는 당신이 무엇을 탐색하는지 결코 볼 수 없습니다."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ iPhone ನಲ್ಲಿ ನಿರ್ಬಂಧಿಸುವುದು ಸಂಭವಿಸುತ್ತದೆ. ನೀವು ಬ್ರೌಸ್ ಮಾಡುವುದನ್ನು ನಾವು ಎಂದಿಗೂ ನೋಡುವುದಿಲ್ಲ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या iPhone वर ब्लॉकिंग होते. तुम्ही जे ब्राउझ करता ते आम्ही कधीच पाहत नाही."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ iPhone-ൽ തടയൽ സംഭവിക്കുന്നു. നിങ്ങൾ ബ്രൗസ് ചെയ്യുന്നത് ഞങ്ങൾ ഒരിക്കലും കാണുന്നില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyekatan berlaku pada iPhone anda. Kami tidak pernah melihat apa yang anda semak imbas."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokkeren gebeurt op uw iPhone. We zien nooit wat u bladert."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କର iPhone ରେ ଅବରୋଧ ହୁଏ | ଆପଣ କ’ଣ ବ୍ରାଉଜ୍ କରନ୍ତି ଆମେ କଦାପି ଦେଖୁନାହୁଁ |"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਬਲਾਕਿੰਗ ਤੁਹਾਡੇ iPhone 'ਤੇ ਹੁੰਦੀ ਹੈ। ਅਸੀਂ ਕਦੇ ਨਹੀਂ ਦੇਖਦੇ ਕਿ ਤੁਸੀਂ ਕੀ ਬ੍ਰਾਊਜ਼ ਕਰਦੇ ਹੋ।"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokkering skjer på din iPhone. Vi ser aldri det du blar gjennom."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokowanie odbywa się na Twoim iPhone. Nigdy nie widzimy, co przeglądasz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O bloqueio acontece no seu iPhone. Nunca vemos o que você navega."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O bloqueio acontece no seu iPhone. Nunca vemos o que você navega."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocarea are loc pe iPhone. Nu vedem niciodată ceea ce răsfoiți."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокировка происходит на вашем iPhone. Мы никогда не видим, что вы просматриваете."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokiranje se zgodi na vašem iPhone. Nikoli ne vidimo, kaj brskate."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "K blokovaniu dôjde na vašom iPhone. Nikdy nevidíme, čo prehliadate."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Blockering sker på din iPhone. Vi ser aldrig vad du bläddrar i."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் iPhone இல் தடுப்பது நடக்கும். நீங்கள் உலாவுவதை நாங்கள் பார்க்கவே இல்லை."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบล็อกเกิดขึ้นใน iPhone ของคุณ เราไม่เคยเห็นสิ่งที่คุณเรียกดู"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ iPhoneలో నిరోధించడం జరుగుతుంది. మీరు బ్రౌజ్ చేసే వాటిని మేము ఎప్పుడూ చూడలేము."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокування відбувається на вашому iPhone. Ми ніколи не бачимо, що ви переглядаєте."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بلاک کرنا آپ کے iPhone پر ہوتا ہے۔ ہم کبھی نہیں دیکھتے کہ آپ کیا براؤز کرتے ہیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的 iPhone 上发生阻塞。我们永远不会看到您浏览的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的 iPhone 上發生阻塞。我們永遠不會看到您瀏覽的內容。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc chặn xảy ra trên iPhone của bạn. Chúng tôi không bao giờ nhìn thấy những gì bạn duyệt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Engelleme iPhone cihazınızda gerçekleşir. Neye göz attığınızı asla görmeyiz."
          }
        }
      }
    },
