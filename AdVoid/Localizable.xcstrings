    "Lists check for updates when you open AdVoid, at most every 12 hours. iOS doesn't let them update while the app is closed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen suchen beim Öffnen von AdVoid nach Updates, höchstens alle 12 Stunden. iOS erlaubt keine Updates, während die App geschlossen ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las listas buscan actualizaciones al abrir AdVoid, como mucho cada 12 horas. iOS no permite actualizarlas con la app cerrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les listes recherchent des mises à jour à l’ouverture d’AdVoid, au plus toutes les 12 heures. iOS ne permet pas de les mettre à jour quand l’app est fermée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le liste verificano gli aggiornamenti quando apri AdVoid, al massimo ogni 12 ore. iOS non consente di aggiornarle mentre l'app è chiusa."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Lists check for updates when you open AdVoid, at most every 12 hours. iOS doesn't let them update while the app is closed."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Lists check for updates when you open AdVoid, at most every 12 hours. iOS doesn't let them update while the app is closed."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Lists check for updates when you open AdVoid, at most every 12 hours. iOS doesn't let them update while the app is closed."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Las listas buscan actualizaciones al abrir AdVoid, como mucho cada 12 horas. iOS no permite actualizarlas con la app cerrada."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les listes recherchent des mises à jour à l’ouverture d’AdVoid, au plus toutes les 12 heures. iOS ne permet pas de les mettre à jour quand l’app est fermée."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتحقق القوائم من وجود تحديثات عند فتح AdVoid، كل 12 ساعة على الأكثر. لا يسمح لهم iOS بالتحديث أثناء إغلاق التطبيق."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les llistes comproven si hi ha actualitzacions quan obriu AdVoid, com a màxim cada 12 hores. iOS no els permet actualitzar mentre l'aplicació està tancada."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι λίστες ελέγχουν για ενημερώσεις όταν ανοίγετε το AdVoid, το πολύ κάθε 12 ώρες. Το iOS δεν τους επιτρέπει να ενημερώνονται ενώ η εφαρμογή είναι κλειστή."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি AdVoid খুললে আপডেটের জন্য তালিকা চেক করে, সর্বাধিক প্রতি 12 ঘণ্টায়। অ্যাপ বন্ধ থাকা অবস্থায় iOS তাদের আপডেট করতে দেয় না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Seznamy vyhledávají aktualizace při otevření AdVoid, maximálně každých 12 hodin. iOS jim neumožňuje aktualizovat, když je aplikace zavřená."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Listat tarkistavat päivitykset, kun avaat AdVoid:n, enintään 12 tunnin välein. iOS ei anna niiden päivittää, kun sovellus on suljettu."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જ્યારે તમે AdVoid ખોલો છો, ત્યારે વધુમાં વધુ દર 12 કલાકે યાદીઓ અપડેટ માટે તપાસે છે. જ્યારે એપ્લિકેશન બંધ હોય ત્યારે iOS તેમને અપડેટ કરવા દેતું નથી."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप AdVoid खोलते हैं, तो सूचियाँ अपडेट की जाँच करती हैं, अधिकतम हर 12 घंटे में। ऐप बंद होने पर iOS उन्हें अपडेट नहीं करने देता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Popisi provjeravaju ažuriranja kada otvorite AdVoid, najviše svakih 12 sati. iOS im ne dopušta ažuriranje dok je aplikacija zatvorena."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lister søger efter opdateringer, når du åbner AdVoid, højst hver 12. time. iOS lader dem ikke opdatere, mens appen er lukket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Daftar memeriksa pembaruan saat Anda membuka AdVoid, paling banyak setiap 12 jam. iOS tidak mengizinkan mereka memperbarui saat aplikasi ditutup."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストは、AdVoid を開いたときに、最大 12 時間ごとに更新をチェックします。 iOS では、アプリが閉じている間は更新できません。"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A listák a AdVoid megnyitásakor, legfeljebb 12 óránként ellenőrzik a frissítéseket. A iOS nem engedi, hogy frissítsenek, amíg az alkalmazás be van zárva."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록은 AdVoid를 열 때 최대 12시간마다 업데이트를 확인합니다. iOS는 앱이 닫혀 있는 동안 업데이트를 허용하지 않습니다."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು AdVoid ಅನ್ನು ತೆರೆದಾಗ ಪಟ್ಟಿಗಳು ನವೀಕರಣಗಳಿಗಾಗಿ ಪರಿಶೀಲಿಸುತ್ತವೆ, ಹೆಚ್ಚೆಂದರೆ ಪ್ರತಿ 12 ಗಂಟೆಗಳಿಗೊಮ್ಮೆ. ಅಪ್ಲಿಕೇಶನ್ ಮುಚ್ಚಿರುವಾಗ ಅವುಗಳನ್ನು ನವೀಕರಿಸಲು iOS ಅನುಮತಿಸುವುದಿಲ್ಲ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही AdVoid उघडता तेव्हा याद्या अद्यतनांसाठी तपासतात, जास्तीत जास्त दर 12 तासांनी. ॲप बंद असताना iOS त्यांना अपडेट करू देत नाही."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ AdVoid തുറക്കുമ്പോൾ ലിസ്‌റ്റുകൾ അപ്‌ഡേറ്റുകൾക്കായി പരിശോധിക്കുന്നു, പരമാവധി ഓരോ 12 മണിക്കൂറിലും. ആപ്പ് അടച്ചിരിക്കുമ്പോൾ iOS അവരെ അപ്‌ഡേറ്റ് ചെയ്യാൻ അനുവദിക്കുന്നില്ല."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Senarai menyemak kemas kini apabila anda membuka AdVoid, paling banyak setiap 12 jam. iOS tidak membenarkan mereka mengemas kini semasa apl ditutup."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Lijsten controleren op updates wanneer u AdVoid opent, maximaal elke 12 uur. iOS laat ze niet updaten terwijl de app gesloten is."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପ୍ରତ୍ୟେକ 12 ଘଣ୍ଟାରେ, ଯେତେବେଳେ ଆପଣ AdVoid ଖୋଲନ୍ତି, ତାଲିକାଗୁଡ଼ିକ ଅଦ୍ୟତନଗୁଡିକ ଯାଞ୍ଚ କରେ | ଆପ୍ ବନ୍ଦ ଥିବାବେଳେ iOS ସେମାନଙ୍କୁ ଅପଡେଟ୍ କରିବାକୁ ଦିଏ ନାହିଁ |"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਦੋਂ ਤੁਸੀਂ AdVoid ਖੋਲ੍ਹਦੇ ਹੋ, ਵੱਧ ਤੋਂ ਵੱਧ ਹਰ 12 ਘੰਟਿਆਂ ਵਿੱਚ ਸੂਚੀਆਂ ਅੱਪਡੇਟ ਦੀ ਜਾਂਚ ਕਰਦੀਆਂ ਹਨ। iOS ਉਹਨਾਂ ਨੂੰ ਐਪ ਦੇ ਬੰਦ ਹੋਣ 'ਤੇ ਅੱਪਡੇਟ ਨਹੀਂ ਹੋਣ ਦਿੰਦਾ।"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lister ser etter oppdateringer når du åpner AdVoid, maksimalt hver 12. time. iOS lar dem ikke oppdatere mens appen er stengt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Listy sprawdzają dostępność aktualizacji po otwarciu AdVoid, najwyżej co 12 godzin. iOS nie pozwala na aktualizację, gdy aplikacja jest zamknięta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As listas verificam se há atualizações quando você abre o AdVoid, no máximo a cada 12 horas. iOS não permite que eles sejam atualizados enquanto o aplicativo está fechado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As listas verificam se há atualizações quando você abre o AdVoid, no máximo a cada 12 horas. iOS não permite que eles sejam atualizados enquanto o aplicativo está fechado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Listele verifică actualizările când deschideți AdVoid, cel mult la fiecare 12 ore. iOS nu le lasă să se actualizeze în timp ce aplicația este închisă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Списки проверяют наличие обновлений при открытии AdVoid, максимум каждые 12 часов. iOS не позволяет им обновляться, пока приложение закрыто."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Seznami preverjajo posodobitve, ko odprete AdVoid, največ vsakih 12 ur. iOS jim ne dovoli posodobitve, ko je aplikacija zaprta."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoznamy kontrolujú aktualizácie pri otvorení AdVoid, maximálne každých 12 hodín. iOS im neumožňuje aktualizovať, keď je aplikácia zatvorená."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Listor söker efter uppdateringar när du öppnar AdVoid, högst var 12:e timme. iOS låter dem inte uppdatera medan appen är stängd."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் AdVoid ஐத் திறக்கும் போது, அதிகபட்சம் ஒவ்வொரு 12 மணிநேரமும் பட்டியல்கள் புதுப்பிப்புகளைச் சரிபார்க்கும். பயன்பாடு மூடப்பட்டிருக்கும் போது iOS அவற்றை புதுப்பிக்க அனுமதிக்காது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการตรวจสอบการอัปเดตเมื่อคุณเปิด AdVoid มากที่สุดทุกๆ 12 ชั่วโมง iOS ไม่อนุญาตให้อัปเดตในขณะที่แอปปิดอยู่"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు గరిష్టంగా ప్రతి 12 గంటలకు AdVoidని తెరిచినప్పుడు జాబితాలు అప్‌డేట్‌ల కోసం తనిఖీ చేస్తాయి. యాప్ మూసివేయబడినప్పుడు iOS వాటిని అప్‌డేట్ చేయడానికి అనుమతించదు."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Списки перевіряють наявність оновлень, коли ви відкриваєте AdVoid, щонайбільше кожні 12 годин. iOS не дозволяє їм оновлюватись, коли додаток закрито."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب آپ AdVoid کھولتے ہیں تو فہرستیں اپ ڈیٹس کی جانچ کرتی ہیں، زیادہ سے زیادہ ہر 12 گھنٹے بعد۔ iOS ایپ کے بند ہونے کے دوران انہیں اپ ڈیٹ نہیں ہونے دیتا۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "列表在您打开 AdVoid 时检查更新，最多每 12 小时检查一次。 iOS 不允许它们在应用程序关闭时更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清單在您開啟 AdVoid 時檢查更新，最多每 12 小時檢查一次。 iOS 不允許它們在應用程式關閉時更新。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Danh sách kiểm tra các bản cập nhật khi bạn mở AdVoid, tối đa 12 giờ một lần. iOS không cho phép họ cập nhật khi đóng ứng dụng."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AdVoid'yi açtığınızda, en fazla 12 saatte bir, listeler güncellemeleri kontrol eder. iOS, uygulama kapalıyken bunların güncellenmesine izin vermez."
          }
        }
      }
    },
