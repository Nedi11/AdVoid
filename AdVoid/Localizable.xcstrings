    "Starts blocking ads and trackers across your iPhone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blockiert ab sofort Werbung und Tracker auf deinem ganzen iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza a bloquear anuncios y rastreadores en todo tu iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commence à bloquer les publicités et traqueurs sur tout votre iPhone."
          }
        },
        "it": {
